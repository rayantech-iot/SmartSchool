<div class="min-h-screen flex items-center justify-center bg-primary px-4 py-10">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold font-alkalami text-primary">Inscription parent</h1>
      <p class="text-sm text-gray-500 mt-1">Liez votre compte à votre enfant avec son matricule</p>
    </div>

    <% if (flash && flash.error && flash.error.length) { %>
      <div class="mb-4 p-3 bg-red-50 text-red-700 text-sm rounded-xl"><%= flash.error[0] %></div>
    <% } %>

    <form action="/inscription/parent" method="POST" class="space-y-4">
      <%- include('../partials/csrfField') %>
      <p class="text-xs font-bold text-gray-400 uppercase">Vos informations</p>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="block text-sm font-semibold mb-1">Nom *</label><input type="text" name="nom" required class="w-full rounded-xl border px-3 py-2" /></div>
        <div><label class="block text-sm font-semibold mb-1">Prénom *</label><input type="text" name="prenom" required class="w-full rounded-xl border px-3 py-2" /></div>
      </div>
      <div><label class="block text-sm font-semibold mb-1">Email *</label><input type="email" name="email" required class="w-full rounded-xl border px-3 py-2" /></div>
      <div><label class="block text-sm font-semibold mb-1">Téléphone</label><input type="text" name="telephone" class="w-full rounded-xl border px-3 py-2" /></div>

      <p class="text-xs font-bold text-gray-400 uppercase pt-2">Votre enfant</p>
      <div><label class="block text-sm font-semibold mb-1">Matricule de l'enfant *</label><input type="text" name="matricule" required class="w-full rounded-xl border px-3 py-2 uppercase" /></div>
      <div><label class="block text-sm font-semibold mb-1">Date de naissance de l'enfant *</label><input type="date" name="date_naissance_enfant" required class="w-full rounded-xl border px-3 py-2" /></div>
      <div><label class="block text-sm font-semibold mb-1">Lien de parenté</label>
        <select name="lien" class="w-full rounded-xl border px-3 py-2 bg-white">
          <option value="père">Père</option><option value="mère">Mère</option><option value="tuteur" selected>Tuteur</option>
        </select>
      </div>
      <button type="submit" class="w-full py-3 bg-primary text-white font-bold rounded-xl">Créer mon compte</button>
    </form>
    <p class="text-center mt-4 text-sm"><a href="/inscription" class="text-gray-500 hover:underline">← Retour</a></p>
  </div>
</div>
