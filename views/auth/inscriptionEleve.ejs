<div class="min-h-screen flex items-center justify-center bg-primary px-4 py-10">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold font-alkalami text-primary">Inscription élève</h1>
      <p class="text-sm text-gray-500 mt-1">Votre dossier sera validé par l'administration</p>
    </div>

    <% if (flash && flash.error && flash.error.length) { %>
      <div class="mb-4 p-3 bg-red-50 text-red-700 text-sm rounded-xl"><%= flash.error[0] %></div>
    <% } %>
    <% if (flash && flash.info && flash.info.length) { %>
      <div class="mb-4 p-3 bg-blue-50 text-blue-800 text-sm rounded-xl"><%= flash.info[0] %></div>
    <% } %>

    <form action="/inscription/eleve" method="POST" class="space-y-4">
      <%- include('../partials/csrfField') %>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="block text-sm font-semibold mb-1">Nom *</label><input type="text" name="nom" required class="w-full rounded-xl border px-3 py-2" /></div>
        <div><label class="block text-sm font-semibold mb-1">Prénom *</label><input type="text" name="prenom" required class="w-full rounded-xl border px-3 py-2" /></div>
      </div>
      <div><label class="block text-sm font-semibold mb-1">Email *</label><input type="email" name="email" required class="w-full rounded-xl border px-3 py-2" placeholder="votre.email@exemple.tg" /></div>
      <div><label class="block text-sm font-semibold mb-1">Téléphone</label><input type="text" name="telephone" class="w-full rounded-xl border px-3 py-2" /></div>
      <div><label class="block text-sm font-semibold mb-1">Matricule</label><input type="text" name="matricule" class="w-full rounded-xl border px-3 py-2 uppercase" placeholder="Si fourni par l'école" /></div>
      <div><label class="block text-sm font-semibold mb-1">Date de naissance *</label><input type="date" name="date_naissance" required class="w-full rounded-xl border px-3 py-2" /></div>
      <button type="submit" class="w-full py-3 bg-primary text-white font-bold rounded-xl">S'inscrire</button>
    </form>
    <p class="text-center mt-4 text-sm"><a href="/inscription" class="text-gray-500 hover:underline">← Retour</a></p>
  </div>
</div>
