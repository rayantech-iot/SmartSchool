<!-- views/auth/login.ejs — Page connexion (charte SmartSchool, sans dégradé) -->
<div class="min-h-screen flex items-center justify-center bg-primary py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-2xl shadow-2xl border border-gray-200">
    <div class="text-center">
      <div class="logo-box mx-auto">
        <img src="/images/logo.svg" alt="SmartSchool" class="w-14 h-14" />
      </div>
      <h2 class="mt-6 text-3xl font-alkalami text-primary tracking-tight">SmartSchool</h2>
      <p class="mt-2 text-sm text-textDark">
        Système Digital de Gestion & Communication Scolaire — Togo
      </p>
    </div>

    <% if (typeof flash !== 'undefined' && flash.error && flash.error.length > 0) { %>
      <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md">
        <p class="text-sm text-red-700 font-medium flex items-center">
          <i class="fas fa-times-circle mr-2"></i><%= flash.error[0] %>
        </p>
      </div>
    <% } %>

    <% if (typeof flash !== 'undefined' && flash.success && flash.success.length > 0) { %>
      <div class="bg-blue-50 border-l-4 border-secondary p-4 rounded-md">
        <p class="text-sm text-primary font-medium flex items-center">
          <i class="fas fa-check-circle mr-2 text-secondary"></i><%= flash.success[0] %>
        </p>
      </div>
    <% } %>

    <form class="mt-6 space-y-6" action="/login" method="POST">
      <%- include('../partials/csrfField') %>
      <div class="space-y-4">
        <div>
          <label for="email-address" class="block text-sm font-semibold text-textDark mb-1">Adresse Email</label>
          <div class="relative">
            <i class="fas fa-envelope absolute left-3 top-3.5 text-gray-400"></i>
            <input id="email-address" name="email" type="email" required
              class="form-input pl-10" placeholder="votre.email@ecole.tg" />
          </div>
        </div>
        <div>
          <label for="password" class="block text-sm font-semibold text-textDark mb-1">Mot de passe</label>
          <div class="relative">
            <i class="fas fa-lock absolute left-3 top-3.5 text-gray-400"></i>
            <input id="password" name="motDePasse" type="password" required
              class="form-input pl-10" placeholder="••••••••" />
          </div>
        </div>
      </div>

      <button type="submit" class="btn-submit w-full flex items-center justify-center">
        <i class="fas fa-sign-in-alt mr-2"></i> Se connecter
      </button>
    </form>

    <p class="text-center mt-6 text-sm text-gray-600">
      Pas encore de compte ?
      <a href="/inscription" class="text-secondary font-semibold hover:underline">S'inscrire (élève ou parent)</a>
    </p>

    <div class="mt-8 border-t border-gray-200 pt-6">
      <h3 class="text-xs font-semibold text-textDark uppercase tracking-wider text-center mb-4">
        Comptes de démonstration
      </h3>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <button type="button" onclick="fillForm('admin@smartschool.tg', 'Admin123!')"
          class="p-2 bg-background hover:bg-blue-50 border border-gray-200 rounded-lg text-left transition-colors">
          <p class="font-semibold text-textDark">Administrateur</p>
          <p class="text-gray-500">admin@smartschool.tg</p>
        </button>
        <button type="button" onclick="fillForm('prof.koffi@smartschool.tg', 'Prof123!')"
          class="p-2 bg-background hover:bg-blue-50 border border-gray-200 rounded-lg text-left transition-colors">
          <p class="font-semibold text-textDark">Professeur</p>
          <p class="text-gray-500">Koffi (Maths)</p>
        </button>
        <button type="button" onclick="fillForm('eleve.amede@smartschool.tg', 'Eleve123!')"
          class="p-2 bg-background hover:bg-blue-50 border border-gray-200 rounded-lg text-left transition-colors">
          <p class="font-semibold text-textDark">Élève</p>
          <p class="text-gray-500">Amede</p>
        </button>
        <button type="button" onclick="fillForm('parent.amede@smartschool.tg', 'Parent123!')"
          class="p-2 bg-background hover:bg-blue-50 border border-gray-200 rounded-lg text-left transition-colors">
          <p class="font-semibold text-textDark">Parent</p>
          <p class="text-gray-500">Parent de Amede</p>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function fillForm(email, pwd) {
    document.getElementById('email-address').value = email;
    document.getElementById('password').value = pwd;
  }
</script>
