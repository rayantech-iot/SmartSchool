<!-- views/professeur/dashboard.ejs -->
<div class="space-y-8 animate-fadeIn">
  
  <!-- Header / En-tête -->
  <div class="page-header flex flex-col md:flex-row md:items-center md:justify-between">
    <div>
      <span class="px-2.5 py-1 bg-white/20 backdrop-blur rounded-lg text-xs font-bold uppercase tracking-wider">
        Espace Enseignant
      </span>
      <h1 class="text-3xl font-bold font-alkalami mt-2">Bonjour, M. <%= user.prenom %> <%= user.nom %></h1>
      <p class="mt-1 text-blue-100 text-sm">Spécialité : <%= professeur.specialite || 'Enseignant polyvalent' %> | Grade : <%= professeur.grade || 'N/A' %></p>
    </div>
    <div class="mt-4 md:mt-0 flex flex-wrap gap-2">
      <a href="/professeur/notes" class="px-4 py-2 bg-white text-primary hover:bg-gray-100 rounded-xl text-sm font-bold transition-all shadow-md flex items-center">
        <i class="fas fa-star mr-1.5 text-secondary"></i> Saisir Notes
      </a>
      <a href="/professeur/presences" class="px-4 py-2 bg-secondary hover:bg-primary rounded-xl text-sm font-bold transition-all shadow-md flex items-center">
        <i class="fas fa-clipboard-check mr-1.5 text-white"></i> Faire l'appel
      </a>
    </div>
  </div>

  <!-- Statistiques rapides -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center space-x-4 hover:shadow-md transition-all group duration-300">
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
        <i class="fas fa-school text-2xl"></i>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-400 uppercase tracking-wider">Classes affectées</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= classes.length %></h3>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center space-x-4 hover:shadow-md transition-all group duration-300">
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-primary flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
        <i class="fas fa-user-graduate text-2xl"></i>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-400 uppercase tracking-wider">Élèves suivis</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= totalEleves %></h3>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center space-x-4 hover:shadow-md transition-all group duration-300">
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-secondary flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
        <i class="fas fa-book text-2xl"></i>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-400 uppercase tracking-wider">Matières</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= matieres.length %></h3>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex items-center space-x-4 hover:shadow-md transition-all group duration-300">
      <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
        <i class="fas fa-envelope text-2xl"></i>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-400 uppercase tracking-wider">Messages non lus</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= messagesNonLus %></h3>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Séances d'aujourd'hui -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-6">
      <div class="flex justify-between items-center border-b border-gray-100 pb-3">
        <h2 class="text-xl font-bold text-gray-800 flex items-center">
          <i class="fas fa-calendar-day text-primary mr-2"></i> Cours du jour
        </h2>
        <span class="text-xs bg-gray-100 font-semibold px-2 py-1 rounded text-gray-500 uppercase tracking-wider">
          <%= jourAujourdhui %>
        </span>
      </div>

      <div class="space-y-4">
        <% seancesAujourdhui.forEach(s => { %>
          <div class="p-4 bg-gray-50 hover:bg-blue-50/50 rounded-xl border border-gray-100 transition-colors flex items-center justify-between">
            <div>
              <span class="text-[10px] font-bold text-gray-400 font-mono"><%= s.heure_debut %> - <%= s.heure_fin %></span>
              <h4 class="font-bold text-gray-800 text-sm mt-0.5"><%= s.matiere ? s.matiere.nom : 'Matière' %></h4>
              <p class="text-xs text-gray-500">Classe : <%= s.emploiDuTemps && s.emploiDuTemps.classe ? s.emploiDuTemps.classe.nom : 'Inconnue' %></p>
            </div>
            <% if (s.salle) { %>
              <span class="px-2.5 py-1 bg-white border border-gray-200 text-slate-700 text-xs font-mono font-bold rounded-lg shadow-sm">
                Salle <%= s.salle %>
              </span>
            <% } %>
          </div>
        <% }) %>

        <% if (seancesAujourdhui.length === 0) { %>
          <div class="bg-gray-50 p-8 rounded-xl text-center text-gray-400">
            <i class="fas fa-mug-hot text-3xl mb-2 text-gray-300"></i>
            <p class="text-xs italic">Aucun cours planifié pour aujourd'hui.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Devoirs récents (2/3 restants) -->
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 lg:col-span-2 space-y-6">
      <div class="flex justify-between items-center border-b border-gray-100 pb-3">
        <h2 class="text-xl font-bold text-gray-800 flex items-center">
          <i class="fas fa-tasks text-secondary mr-2"></i> Cahier de textes (Devoirs récents)
        </h2>
        <a href="/professeur/devoirs" class="text-xs text-secondary hover:text-primary font-semibold transition-colors">
          Voir tout <i class="fas fa-chevron-right ml-1 text-[9px]"></i>
        </a>
      </div>

      <div class="space-y-4">
        <% devoirsRecents.forEach(d => { %>
          <div class="p-4 bg-gray-50 hover:bg-blue-50/30 border border-gray-100 rounded-xl transition-all flex items-start justify-between">
            <div class="space-y-1">
              <div class="flex items-center space-x-2">
                <span class="px-2 py-0.5 bg-blue-100 text-primary text-[10px] font-bold rounded">
                  <%= d.classe ? d.classe.nom : 'Classe' %>
                </span>
                <span class="px-2 py-0.5 bg-blue-100 text-blue-800 text-[10px] font-bold rounded">
                  <%= d.matiere ? d.matiere.nom : 'Matière' %>
                </span>
              </div>
              <h4 class="font-bold text-gray-800 text-sm"><%= d.titre %></h4>
              <p class="text-xs text-gray-500 line-clamp-1"><%= d.description || 'Pas de consigne supplémentaire.' %></p>
            </div>
            <div class="text-right">
              <span class="block text-[10px] text-gray-400 uppercase tracking-wider font-semibold">À rendre pour le</span>
              <span class="text-xs font-bold text-red-600 font-mono"><%= new Date(d.date_limite).toLocaleDateString('fr-FR') %></span>
            </div>
          </div>
        <% }) %>

        <% if (devoirsRecents.length === 0) { %>
          <div class="bg-gray-50 p-12 rounded-xl text-center text-gray-400">
            <i class="fas fa-pencil-alt text-3xl mb-2 text-gray-300"></i>
            <p class="text-sm italic">Vous n'avez publié aucun devoir récemment.</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</div>
