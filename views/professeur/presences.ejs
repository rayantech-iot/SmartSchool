<!-- views/professeur/presences.ejs -->
<div class="space-y-8 animate-fadeIn">
  
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Gestion des Présences / Appel</h1>
      <p class="text-sm text-gray-500 mt-1">Faites l'appel de vos élèves séance par séance.</p>
    </div>
    <div class="mt-4 md:mt-0 flex flex-wrap gap-2">
      <% if (filtres && filtres.classe_id && filtres.date) { %>
        <a href="/professeur/presences/export?classe_id=<%= filtres.classe_id %>&date=<%= filtres.date %>"
          class="px-4 py-2 bg-secondary hover:bg-primary text-white text-sm font-semibold rounded-xl transition-all inline-flex items-center">
          <i class="fas fa-file-csv mr-1"></i> Exporter CSV
        </a>
      <% } %>
      <a href="/professeur/dashboard" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
        <i class="fas fa-arrow-left mr-1"></i> Tableau de bord
      </a>
    </div>
  </div>

  <!-- Barre de filtrage (Sélection classe, date) -->
  <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
    <form action="/professeur/presences" method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
      
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Classe</label>
        <select name="classe_id" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
          <option value="">-- Choisir une classe --</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= filtres.classe_id == c.id ? 'selected' : '' %>><%= c.niveau %> — <%= c.nom %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Date de l'appel</label>
        <input type="date" name="date" required value="<%= filtres.date %>"
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
      </div>

      <div>
        <button type="submit"
          class="w-full py-2.5 bg-primary hover:bg-blue-800 text-white font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-1.5">
          <i class="fas fa-clipboard-list"></i>
          <span>Charger la Fiche d'Appel</span>
        </button>
      </div>

    </form>
  </div>

  <!-- Fiche de présence -->
  <% if (filtres.classe_id && filtres.date) { %>
    <form action="/professeur/presences" method="POST" class="space-y-6">
      <%- include('../partials/csrfField') %>
      <input type="hidden" name="date" value="<%= filtres.date %>">

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        
        <!-- Header Fiche -->
        <div class="p-5 border-b border-gray-100 bg-gray-50/50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <h2 class="font-bold text-gray-800 flex items-center">
            <i class="fas fa-check-double text-secondary mr-2"></i> Appel du <%= new Date(filtres.date).toLocaleDateString('fr-FR') %>
          </h2>
          
          <!-- Sélection Séance (cours du jour pour cette classe) -->
          <div class="flex items-center space-x-2">
            <label class="text-xs font-semibold text-gray-500">Séance / Horaire :</label>
            <% if (seances && seances.length) { %>
            <select name="seance_id" required
              class="rounded-xl border border-gray-300 px-3 py-1.5 bg-white text-xs text-gray-800 focus:outline-none focus:ring-1 focus:ring-secondary">
              <option value="">-- Choisir le cours --</option>
              <% seances.forEach(s => { %>
                <option value="<%= s.id %>">
                  <%= s.heure_debut %> - <%= s.heure_fin %> | <%= s.matiere ? s.matiere.nom : 'Matière' %><% if (s.salle) { %> — <%= s.salle %><% } %>
                </option>
              <% }) %>
            </select>
            <% } else { %>
            <span class="text-xs text-amber-700 bg-amber-50 px-2 py-1 rounded-lg">Aucun cours programmé ce jour pour cette classe.</span>
            <% } %>
          </div>
        </div>

        <!-- Tableau des élèves -->
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50/70">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Élève</th>
                <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Présent</th>
                <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Absent</th>
                <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">En Retard</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Observation / Remarque</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% eleves.forEach((eleve, index) => { %>
                <% 
                  // Vérifier s'il y a déjà un statut enregistré pour cet élève aujourd'hui
                  const presenceExistante = presences.find(p => p.eleve_id === eleve.id);
                  const statutActuel = presenceExistante ? presenceExistante.statut : 'present';
                  const observationActuelle = presenceExistante ? presenceExistante.observation : '';
                %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                  <input type="hidden" name="presences[<%= index %>][eleve_id]" value="<%= eleve.id %>">
                  
                  <!-- Identité -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center space-x-3">
                      <div class="w-9 h-9 bg-primary/10 text-primary rounded-xl flex items-center justify-center font-bold text-sm">
                        <%= eleve.utilisateur ? eleve.utilisateur.nom.charAt(0) : 'E' %><%= eleve.utilisateur ? eleve.utilisateur.prenom.charAt(0) : '' %>
                      </div>
                      <div class="text-sm font-semibold text-gray-900">
                        <%= eleve.utilisateur ? eleve.utilisateur.prenom : '' %> <%= eleve.utilisateur ? eleve.utilisateur.nom : '' %>
                      </div>
                    </div>
                  </td>

                  <!-- Radio Présent -->
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <label class="inline-flex items-center justify-center p-2 rounded-xl bg-blue-50 hover:bg-blue-100 cursor-pointer border border-blue-100 transition-all">
                      <input type="radio" name="presences[<%= index %>][statut]" value="present" 
                        <%= statutActuel === 'present' ? 'checked' : '' %>
                        class="h-4 w-4 text-secondary focus:ring-secondary border-gray-300">
                    </label>
                  </td>

                  <!-- Radio Absent -->
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <label class="inline-flex items-center justify-center p-2 rounded-xl bg-red-50 hover:bg-red-100 cursor-pointer border border-red-100 transition-all">
                      <input type="radio" name="presences[<%= index %>][statut]" value="absent"
                        <%= statutActuel === 'absent' ? 'checked' : '' %>
                        class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300">
                    </label>
                  </td>

                  <!-- Radio Retard -->
                  <td class="px-6 py-4 whitespace-nowrap text-center">
                    <label class="inline-flex items-center justify-center p-2 rounded-xl bg-background hover:bg-blue-50 cursor-pointer border border-gray-200 transition-all">
                      <input type="radio" name="presences[<%= index %>][statut]" value="retard"
                        <%= statutActuel === 'retard' ? 'checked' : '' %>
                        class="h-4 w-4 text-secondary focus:ring-secondary border-gray-300">
                    </label>
                  </td>

                  <!-- Observation -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <input type="text" name="presences[<%= index %>][observation]" value="<%= observationActuelle %>"
                      placeholder="Motif de retard, comportement..."
                      class="w-full text-xs rounded-lg border border-gray-300 px-3 py-1.5 text-gray-900 focus:outline-none focus:ring-1 focus:ring-secondary">
                  </td>
                </tr>
              <% }) %>

              <% if (eleves.length === 0) { %>
                <tr>
                  <td colspan="5" class="px-6 py-12 text-center text-gray-500 bg-gray-50/50">
                    <i class="fas fa-users-slash text-3xl mb-2 text-gray-300"></i>
                    <p class="font-medium text-sm">Aucun élève trouvé dans cette classe.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <% if (eleves.length > 0) { %>
        <div class="flex justify-end">
          <button type="submit"
            class="px-6 py-3 bg-primary hover:bg-secondary text-white font-bold rounded-xl shadow-lg transition-all flex items-center space-x-2">
            <i class="fas fa-save"></i>
            <span>Enregistrer la Fiche d'Appel</span>
          </button>
        </div>
      <% } %>

    </form>
  <% } else { %>
    <!-- État initial -->
    <div class="bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl p-16 text-center text-gray-500">
      <i class="fas fa-clipboard-check text-4xl mb-3 text-gray-300"></i>
      <p class="font-bold text-gray-700">Filtre d'appel requis</p>
      <p class="text-sm text-gray-400 mt-1">Sélectionnez une classe et une date ci-dessus pour charger la fiche de présence.</p>
    </div>
  <% } %>
</div>
