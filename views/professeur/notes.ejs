<!-- views/professeur/notes.ejs -->
<div class="space-y-8 animate-fadeIn">
  
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Saisie et Gestion des Notes</h1>
      <p class="text-sm text-gray-500 mt-1">Sélectionnez une classe et une matière pour consulter ou enregistrer les évaluations.</p>
    </div>
    <div class="mt-4 md:mt-0">
      <a href="/professeur/dashboard" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
        <i class="fas fa-arrow-left mr-1"></i> Tableau de bord
      </a>
    </div>
  </div>

  <!-- Barre de filtrage (Sélection classe, matière, période) -->
  <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
    <form action="/professeur/notes" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
      
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Classe</label>
        <select name="classe_id" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
          <option value="">-- Choisir une classe --</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= filtres.classe_id == c.id ? 'selected' : '' %>><%= c.niveau %> — <%= c.nom %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Matière</label>
        <select name="matiere_id" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
          <option value="">-- Choisir une matière --</option>
          <% matieres.forEach(m => { %>
            <option value="<%= m.id %>" <%= filtres.matiere_id == m.id ? 'selected' : '' %>><%= m.nom %><% if (m.code) { %> (<%= m.code %>)<% } %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Période / Trimestre</label>
        <select name="periode" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
          <option value="trimestre1" <%= filtres.periode === 'trimestre1' ? 'selected' : '' %>>1er Trimestre</option>
          <option value="trimestre2" <%= filtres.periode === 'trimestre2' ? 'selected' : '' %>>2ème Trimestre</option>
          <option value="trimestre3" <%= filtres.periode === 'trimestre3' ? 'selected' : '' %>>3ème Trimestre</option>
        </select>
      </div>

      <div>
        <button type="submit"
          class="w-full py-2.5 bg-primary hover:bg-blue-800 text-white font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-1.5">
          <i class="fas fa-search"></i>
          <span>Charger la liste</span>
        </button>
      </div>

    </form>
  </div>

  <!-- Si filtres actifs, charger la grille de saisie -->
  <% if (filtres.classe_id && filtres.matiere_id && filtres.periode) { %>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
      
      <!-- Liste des élèves & de leurs notes (2/3 de l'écran) -->
      <div class="xl:col-span-2 space-y-4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="p-5 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
            <h2 class="font-bold text-gray-800 flex items-center">
              <i class="fas fa-users text-primary mr-2"></i> Grille d'évaluation
            </h2>
            <span class="text-xs bg-blue-100 text-primary font-semibold px-2.5 py-0.5 rounded-full">
              <%= elevesClasse.length %> Élèves rattachés
            </span>
          </div>

          <div class="divide-y divide-gray-150">
            <% elevesClasse.forEach(eleve => { %>
              <% 
                // Récupérer les notes de cet élève spécifique
                const notesEleve = notes.filter(n => n.eleve_id === eleve.id);
                const sumNotes = notesEleve.reduce((acc, n) => acc + parseFloat(n.valeur), 0);
                const moyenneEleve = notesEleve.length ? (sumNotes / notesEleve.length).toFixed(2) : null;
              %>
              <div class="p-5 hover:bg-gray-50/50 transition-colors flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                
                <!-- Identité Élève -->
                <div class="flex items-center space-x-3 min-w-[200px]">
                  <div class="w-10 h-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center font-bold">
                    <%= eleve.utilisateur ? eleve.utilisateur.nom.charAt(0) : 'E' %><%= eleve.utilisateur ? eleve.utilisateur.prenom.charAt(0) : '' %>
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-800 text-sm">
                      <%= eleve.utilisateur ? eleve.utilisateur.prenom : '' %> <%= eleve.utilisateur ? eleve.utilisateur.nom : '' %>
                    </h4>
                    <p class="text-xs text-gray-500">Moyenne: 
                      <strong id="moyenne-eleve-<%= eleve.id %>" class="<%= moyenneEleve ? (parseFloat(moyenneEleve) >= 10 ? 'text-secondary' : 'text-red-500') : 'text-gray-400' %>">
                        <%= moyenneEleve ? moyenneEleve + '/20' : 'Aucune note' %>
                      </strong>
                    </p>
                  </div>
                </div>

                <!-- Notes existantes de l'élève -->
                <div id="notes-list-<%= eleve.id %>" class="flex-1 flex flex-wrap gap-2 items-center">
                  <% notesEleve.forEach(n => { %>
                    <div id="note-badge-<%= n.id %>" class="inline-flex items-center space-x-1.5 px-2.5 py-1 bg-gray-100 hover:bg-red-50 border border-gray-200 rounded-lg group transition-colors">
                      <span class="note-valeur text-xs font-bold text-gray-800"><%= n.valeur %>/20</span>
                      <span class="note-type text-[9px] text-gray-400 font-medium uppercase"><%= n.type_evaluation %></span>
                      
                      <!-- Modifier/Supprimer note -->
                      <div class="hidden group-hover:flex items-center space-x-1 pl-1.5 border-l border-gray-300">
                        <button type="button"
                          onclick="openEditNoteModal(this)"
                          data-id="<%= n.id %>"
                          data-valeur="<%= n.valeur %>"
                          data-type="<%= n.type_evaluation %>"
                          data-appreciation="<%= n.appreciation %>"
                          class="note-btn-edit text-blue-500 hover:text-blue-700 text-[10px]">
                          <i class="fas fa-edit"></i>
                        </button>
                        <button type="button"
                          onclick="deleteNote('<%= n.id %>', '<%= eleve.id %>')"
                          class="text-red-500 hover:text-red-700 text-[10px]">
                          <i class="fas fa-trash-alt"></i>
                        </button>
                      </div>
                    </div>
                  <% }) %>
                </div>

                <!-- Bouton Ajout rapide -->
                <div>
                  <button type="button"
                    data-eleve-id="<%= eleve.id %>"
                    data-eleve-nom="<%= eleve.utilisateur ? (eleve.utilisateur.prenom + ' ' + eleve.utilisateur.nom) : 'Élève' %>"
                    onclick="openAddNoteModal(this)"
                    class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-primary text-xs font-semibold rounded-lg border border-blue-200 transition-colors flex items-center space-x-1">
                    <i class="fas fa-plus-circle"></i>
                    <span>Ajouter note</span>
                  </button>
                </div>

              </div>
            <% }) %>

            <% if (elevesClasse.length === 0) { %>
              <div class="p-12 text-center text-gray-400">
                <i class="fas fa-user-slash text-3xl mb-2 text-gray-300"></i>
                <p class="text-sm italic">Aucun élève rattaché à cette classe.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Info panel (1/3 restant) -->
      <div class="space-y-6">
        <div class="bg-primary p-6 rounded-2xl text-white shadow-lg relative overflow-hidden">
          <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-white/5 rounded-full"></div>
          <h3 class="text-lg font-bold font-alkalami mb-3">Guide de saisie des Notes</h3>
          <ul class="space-y-3 text-xs text-slate-300 leading-relaxed">
            <li class="flex items-start">
              <i class="fas fa-check-circle text-secondary mt-0.5 mr-2"></i>
              <span>Les notes sont automatiquement sur 20.</span>
            </li>
            <li class="flex items-start">
              <i class="fas fa-check-circle text-secondary mt-0.5 mr-2"></i>
              <span>Entrez le type d'évaluation : "devoir", "interrogation", ou "examen".</span>
            </li>
            <li class="flex items-start">
              <i class="fas fa-check-circle text-secondary mt-0.5 mr-2"></i>
              <span>La moyenne de l'élève est recalculée et mise à jour en temps réel lors du dépôt de la note.</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  <% } else { %>
    <!-- État initial sans filtre -->
    <div class="bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl p-16 text-center text-gray-500">
      <i class="fas fa-filter text-4xl mb-3 text-gray-300"></i>
      <p class="font-bold text-gray-700">Filtres de consultation requis</p>
      <p class="text-sm text-gray-400 mt-1">Sélectionnez une classe, une matière et un trimestre ci-dessus pour charger la grille.</p>
    </div>
  <% } %>
</div>

<!-- Modal Ajout Note -->
<div id="add-note-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 transform scale-95 transition-all">
    <div class="flex items-center space-x-3 text-secondary mb-4">
      <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center">
        <i class="fas fa-plus text-lg"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-900">Attribuer une Note</h3>
    </div>
    <p class="text-sm text-gray-500 mb-4">Attribuer une évaluation à <span id="add-note-student" class="font-semibold text-gray-800"></span>.</p>

    <form action="/professeur/notes" method="POST" class="space-y-4">
      <%- include('../partials/csrfField') %>
      <input type="hidden" name="eleve_id" id="add-note-eleve-id">
      <input type="hidden" name="matiere_id" value="<%= filtres.matiere_id %>">
      <input type="hidden" name="periode" value="<%= filtres.periode %>">

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Valeur de la Note (sur 20)</label>
        <input type="number" name="valeur" step="0.25" min="0" max="20" required placeholder="15.5"
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Type</label>
          <select name="type_evaluation" required
            class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
            <option value="devoir">Devoir</option>
            <option value="composition">Examen blanc</option>
            <option value="examen">Examen rouge</option>
            <option value="oral">Oral</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Date</label>
          <input type="date" name="date_evaluation" id="add-note-date" required
            class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Appréciation / Commentaire</label>
        <input type="text" name="appreciation" placeholder="Très bon travail, en progression."
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
      </div>

      <div class="flex justify-end space-x-3 pt-2">
        <button type="button" onclick="closeAddNoteModal()"
          class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
          Annuler
        </button>
        <button type="submit"
          class="px-4 py-2 bg-secondary hover:bg-primary text-white rounded-xl text-sm font-semibold transition-all">
          Enregistrer Note
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Modification Note -->
<div id="edit-note-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 transform scale-95 transition-all">
    <div class="flex items-center space-x-3 text-blue-600 mb-4">
      <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center">
        <i class="fas fa-edit text-lg"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-900">Modifier la Note</h3>
    </div>

    <form id="edit-note-form" method="POST" class="space-y-4">
      <%- include('../partials/csrfField') %>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Valeur de la Note (sur 20)</label>
        <input type="number" name="valeur" id="edit-note-valeur" step="0.25" min="0" max="20" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Type d'évaluation</label>
        <select name="type_evaluation" id="edit-note-type" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="devoir">Devoir</option>
          <option value="composition">Examen blanc</option>
          <option value="examen">Examen rouge</option>
          <option value="oral">Oral</option>
          <option value="pratique">Pratique</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Appréciation / Commentaire</label>
        <input type="text" name="appreciation" id="edit-note-appreciation"
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <div class="flex justify-end space-x-3 pt-2">
        <button type="button" onclick="closeEditNoteModal()"
          class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
          Annuler
        </button>
        <button type="submit"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold transition-all">
          Enregistrer modifications
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Initialiser la date du jour par défaut
  const addNoteDateInput = document.getElementById('add-note-date');
  if (addNoteDateInput) {
    addNoteDateInput.value = new Date().toISOString().substring(0, 10);
  }

  function openAddNoteModal(button) {
    const eleveId = button.dataset.eleveId;
    const studentName = button.dataset.eleveNom;
    document.getElementById('add-note-eleve-id').value = eleveId;
    document.getElementById('add-note-student').innerText = studentName;
    document.getElementById('add-note-modal').style.display = 'flex';
  }

  function closeAddNoteModal() {
    document.getElementById('add-note-modal').style.display = 'none';
  }

  function openEditNoteModal(button) {
    const noteId = button.dataset.id;
    const valeur = button.dataset.valeur;
    const type = button.dataset.type;
    const appreciation = button.dataset.appreciation;
    
    document.getElementById('edit-note-valeur').value = valeur;
    document.getElementById('edit-note-type').value = type;
    document.getElementById('edit-note-appreciation').value = (appreciation === 'null' || !appreciation) ? '' : appreciation;
    document.getElementById('edit-note-form').action = '/professeur/notes/' + noteId + '/update';
    document.getElementById('edit-note-modal').style.display = 'flex';
  }

  function closeEditNoteModal() {
    document.getElementById('edit-note-modal').style.display = 'none';
  }

  // Mettre à jour la moyenne de l'élève en temps réel
  async function updateMoyenne(eleveId) {
    const matiereId = '<%= filtres.matiere_id || "" %>';
    const periode = '<%= filtres.periode || "" %>';
    if (!matiereId || !periode) return;
    
    try {
      const response = await fetch(`/professeur/notes/moyenne?eleve_id=${eleveId}&matiere_id=${matiereId}&periode=${periode}`);
      const data = await response.json();
      const strongEl = document.getElementById(`moyenne-eleve-${eleveId}`);
      if (strongEl) {
        if (data.moyenne !== null && data.moyenne !== undefined) {
          strongEl.textContent = data.moyenne + '/20';
          const moyenneVal = parseFloat(data.moyenne);
          if (moyenneVal >= 10) {
            strongEl.className = 'text-secondary font-bold';
          } else {
            strongEl.className = 'text-red-500 font-bold';
          }
        } else {
          strongEl.textContent = 'Aucune note';
          strongEl.className = 'text-gray-400 font-bold';
        }
      }
    } catch (err) {
      console.error('Erreur lors du recalcul de la moyenne:', err);
    }
  }

  // AJAX pour la suppression de note
  async function deleteNote(noteId, eleveId) {
    if (!confirm('Supprimer cette note ?')) return;
    
    try {
      const response = await fetchWithCsrf(`/professeur/notes/${noteId}/delete`, {
        method: 'POST',
        headers: {
          'Accept': 'application/json'
        }
      });
      
      const result = await response.json();
      if (response.ok && result.success) {
        const badge = document.getElementById(`note-badge-${noteId}`);
        if (badge) {
          badge.style.transition = 'all 0.3s ease';
          badge.style.opacity = '0';
          badge.style.transform = 'scale(0.8)';
          setTimeout(async () => {
            badge.remove();
            await updateMoyenne(eleveId);
          }, 300);
        }
      } else {
        alert(result.error || 'Erreur lors de la suppression.');
      }
    } catch (err) {
      console.error(err);
      alert('Erreur réseau lors de la suppression.');
    }
  }

  // Formulaire d'ajout en AJAX
  const addForm = document.querySelector('#add-note-modal form');
  if (addForm) {
    addForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      
      const formData = new FormData(this);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const response = await fetchWithCsrf('/professeur/notes', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if (response.ok && result.success) {
          const note = result.note;
          const eleveId = data.eleve_id;
          const notesList = document.getElementById(`notes-list-${eleveId}`);
          
          if (notesList) {
            const badgeHtml = `
              <div id="note-badge-${note.id}" class="inline-flex items-center space-x-1.5 px-2.5 py-1 bg-gray-100 hover:bg-red-50 border border-gray-200 rounded-lg group transition-colors">
                <span class="note-valeur text-xs font-bold text-gray-800">${parseFloat(note.valeur).toFixed(2)}/20</span>
                <span class="note-type text-[9px] text-gray-400 font-medium uppercase">${note.type_evaluation}</span>
                <div class="hidden group-hover:flex items-center space-x-1 pl-1.5 border-l border-gray-300">
                  <button type="button"
                    onclick="openEditNoteModal(this)"
                    data-id="${note.id}"
                    data-valeur="${note.valeur}"
                    data-type="${note.type_evaluation}"
                    data-appreciation="${note.appreciation || ''}"
                    class="note-btn-edit text-blue-500 hover:text-blue-700 text-[10px]">
                    <i class="fas fa-edit"></i>
                  </button>
                  <button type="button"
                    onclick="deleteNote('${note.id}', '${eleveId}')"
                    class="text-red-500 hover:text-red-700 text-[10px]">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </div>
              </div>
            `;
            notesList.insertAdjacentHTML('beforeend', badgeHtml);
          }
          
          await updateMoyenne(eleveId);
          closeAddNoteModal();
          this.reset();
          if (addNoteDateInput) {
            addNoteDateInput.value = new Date().toISOString().substring(0, 10);
          }
        } else {
          alert(result.error || 'Erreur lors de l\'enregistrement de la note.');
        }
      } catch (err) {
        console.error(err);
        alert('Erreur réseau lors de l\'enregistrement.');
      }
    });
  }

  // Formulaire de modification en AJAX
  const editForm = document.getElementById('edit-note-form');
  if (editForm) {
    editForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      
      const actionUrl = this.action;
      const formData = new FormData(this);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const response = await fetchWithCsrf(actionUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        const result = await response.json();
        if (response.ok && result.success) {
          const note = result.note;
          const badge = document.getElementById(`note-badge-${note.id}`);
          if (badge) {
            badge.querySelector('.note-valeur').textContent = `${parseFloat(note.valeur).toFixed(2)}/20`;
            badge.querySelector('.note-type').textContent = note.type_evaluation;
            
            const editBtn = badge.querySelector('.note-btn-edit');
            if (editBtn) {
              editBtn.dataset.valeur = note.valeur;
              editBtn.dataset.type = note.type_evaluation;
              editBtn.dataset.appreciation = note.appreciation || '';
            }
          }
          
          await updateMoyenne(note.eleve_id);
          closeEditNoteModal();
        } else {
          alert(result.error || 'Erreur lors de la mise à jour.');
        }
      } catch (err) {
        console.error(err);
        alert('Erreur réseau lors de la mise à jour.');
      }
    });
  }
</script>
