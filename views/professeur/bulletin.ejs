<!-- views/professeur/bulletin.ejs -->
<div class="space-y-8 animate-fadeIn">
  
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4 no-print">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Bulletins Scolaires</h1>
      <p class="text-sm text-gray-500 mt-1">Générez et consultez les bulletins scolaires officiels des élèves.</p>
    </div>
    <div class="mt-4 md:mt-0 space-x-2">
      <% if (bulletin) { %>
        <a href="/professeur/bulletin" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
          <i class="fas fa-arrow-left mr-1"></i> Nouveau bulletin
        </a>
        <button onclick="window.print()" class="px-4 py-2 bg-secondary hover:bg-primary text-white text-sm font-bold rounded-xl shadow-md transition-all inline-flex items-center">
          <i class="fas fa-print mr-1.5"></i> Imprimer le bulletin
        </button>
      <% } else { %>
        <a href="/professeur/dashboard" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
          <i class="fas fa-arrow-left mr-1"></i> Tableau de bord
        </a>
      <% } %>
    </div>
  </div>

  <% if (bulletin === null) { %>
    <!-- ========================================== -->
    <!-- ÉCRAN 1 : FORMULAIRE DE GÉNÉRATION         -->
    <!-- ========================================== -->
    <div class="max-w-xl mx-auto bg-white p-8 rounded-2xl border border-gray-100 shadow-sm space-y-6">
      <div class="flex items-center space-x-3 text-primary">
        <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center">
          <i class="fas fa-file-invoice text-lg"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900">Générer un Bulletin</h3>
      </div>
      <p class="text-sm text-gray-500 leading-relaxed">
        Sélectionnez l'élève et la période pour agréger automatiquement ses notes, calculer sa moyenne pondérée générale, et éditer son bulletin officiel.
      </p>

      <form action="/professeur/bulletin/generer" method="POST" class="space-y-4">
        
      <%- include('../partials/csrfField') %>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Sélectionner l'élève</label>
          <select name="eleve_id" required
            class="w-full rounded-xl border border-gray-300 px-3 py-3 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
            <option value="">-- Choisir un élève --</option>
            <% classes.forEach(c => { %>
              <optgroup label="<%= c.niveau %> — <%= c.nom %>">
                <% if (c.eleves) { %>
                  <% c.eleves.forEach(e => { %>
                    <option value="<%= e.id %>">
                      <%= e.utilisateur ? e.utilisateur.prenom : '' %> <%= e.utilisateur ? e.utilisateur.nom : '' %>
                    </option>
                  <% }) %>
                <% } %>
              </optgroup>
            <% }) %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Période</label>
            <select name="periode" required
              class="w-full rounded-xl border border-gray-300 px-3 py-2.5 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
              <option value="trimestre1">1er Trimestre</option>
              <option value="trimestre2">2ème Trimestre</option>
              <option value="trimestre3">3ème Trimestre</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Année Scolaire</label>
            <input type="text" name="annee_scolaire" required value="<%= typeof anneeScolaire !== 'undefined' ? anneeScolaire : '2025-2026' %>"
              class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
          </div>
        </div>

        <button type="submit"
          class="w-full py-3 bg-primary hover:bg-secondary text-white font-bold rounded-xl shadow-lg transition-all flex items-center justify-center space-x-2">
          <i class="fas fa-cogs"></i>
          <span>Générer et Ouvrir le bulletin</span>
        </button>
      </form>
    </div>

    <div class="max-w-xl mx-auto mt-8 bg-white p-8 rounded-2xl border border-secondary/30 shadow-sm space-y-4">
      <h3 class="text-lg font-bold text-gray-900"><i class="fas fa-users text-secondary mr-2"></i>Publier à toute une classe</h3>
      <p class="text-sm text-gray-500">Génère les bulletins de tous les élèves de la classe et notifie chaque élève et ses parents.</p>
      <form action="/professeur/bulletin/publier-classe" method="POST" class="space-y-4">
        <%- include('../partials/csrfField') %>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Classe</label>
          <select name="classe_id" required class="w-full rounded-xl border border-gray-300 px-3 py-2.5 bg-white">
            <option value="">-- Choisir --</option>
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.niveau %> — <%= c.nom %></option>
            <% }) %>
          </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Période</label>
            <select name="periode" required class="w-full rounded-xl border border-gray-300 px-3 py-2.5 bg-white">
              <option value="trimestre1">1er Trimestre</option>
              <option value="trimestre2">2ème Trimestre</option>
              <option value="trimestre3">3ème Trimestre</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Année</label>
            <input type="text" name="annee_scolaire" required value="<%= typeof anneeScolaire !== 'undefined' ? anneeScolaire : '2025-2026' %>" class="w-full rounded-xl border border-gray-300 px-3 py-2.5">
          </div>
        </div>
        <button type="submit" class="w-full py-3 bg-secondary hover:bg-primary text-white font-bold rounded-xl shadow-md">
          <i class="fas fa-paper-plane mr-1"></i> Publier les bulletins de la classe
        </button>
      </form>
    </div>

  <% } else { %>
    <!-- ========================================== -->
    <!-- ÉCRAN 2 : VISUALISATION DU BULLETIN       -->
    <!-- ========================================== -->
    <div class="bg-white rounded-3xl border border-gray-200 shadow-xl overflow-hidden p-8 max-w-4xl mx-auto relative print:border-none print:shadow-none print:p-0">
      
      <!-- Logo filigrane Togo -->
      <div class="absolute right-8 top-8 w-24 h-24 opacity-10 flex items-center justify-center pointer-events-none">
        <i class="fas fa-graduation-cap text-8xl text-primary"></i>
      </div>

      <!-- En-tête officiel Togo -->
      <div class="grid grid-cols-2 gap-4 border-b-2 border-gray-900 pb-6 mb-8 text-xs font-semibold uppercase">
        <div class="space-y-1">
          <p class="text-primary font-bold text-sm tracking-wider">République Togolaise</p>
          <p class="text-[10px] text-gray-500">Travail — Liberté — Patrie</p>
          <p class="text-slate-700 font-bold mt-2">Établissement Scolaire Moderne</p>
        </div>
        <div class="text-right space-y-1">
          <p class="text-gray-900">Année Académique : <%= bulletin.annee_scolaire %></p>
          <p class="text-gray-500">Généré le : <%= new Date(bulletin.date_generation).toLocaleDateString('fr-FR') %></p>
        </div>
      </div>

      <!-- Informations de l'élève -->
      <div class="bg-slate-50 border border-gray-200 rounded-2xl p-6 grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 text-sm">
        <div class="space-y-1.5">
          <span class="text-xs uppercase font-bold text-gray-400 block tracking-wider">Élève</span>
          <p class="text-lg font-bold text-gray-800">
            <%= bulletin.eleve && bulletin.eleve.utilisateur ? bulletin.eleve.utilisateur.prenom : '' %> 
            <%= bulletin.eleve && bulletin.eleve.utilisateur ? bulletin.eleve.utilisateur.nom : '' %>
          </p>
          <p class="text-gray-500 font-medium">Email : <%= bulletin.eleve && bulletin.eleve.utilisateur ? bulletin.eleve.utilisateur.email : '' %></p>
        </div>
        <div class="space-y-1.5 md:text-right">
          <span class="text-xs uppercase font-bold text-gray-400 block tracking-wider">Classe & Période</span>
          <p class="text-lg font-bold text-gray-800"><%= bulletin.classe ? bulletin.classe.niveau + ' ' + bulletin.classe.nom : 'N/A' %></p>
          <span class="inline-block px-3 py-1 bg-primary text-white font-bold text-xs rounded-full uppercase">
            <%= bulletin.periode %>
          </span>
        </div>
      </div>

      <!-- Tableau des Notes par Matière -->
      <div class="overflow-hidden border border-gray-300 rounded-2xl mb-8">
        <table class="min-w-full divide-y divide-gray-300 text-sm">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th scope="col" class="px-6 py-3.5 text-left font-semibold">Matières d'Enseignement</th>
              <th scope="col" class="px-6 py-3.5 text-center font-semibold">Coef</th>
              <th scope="col" class="px-6 py-3.5 text-center font-semibold">Notes Obtenues</th>
              <th scope="col" class="px-6 py-3.5 class text-center font-semibold">Moyenne / 20</th>
              <th scope="col" class="px-6 py-3.5 text-left font-semibold">Appréciation / Observation</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% noteParMatiere.forEach(g => { %>
              <tr class="hover:bg-slate-50/50">
                <!-- Matière -->
                <td class="px-6 py-4">
                  <div class="font-bold text-gray-900"><%= g.matiere.nom %></div>
                  <div class="text-xs text-gray-500 font-mono"><%= g.matiere.code %></div>
                </td>
                
                <!-- Coefficient -->
                <td class="px-6 py-4 text-center font-semibold text-slate-600">
                  <%= g.matiere.coefficient %>
                </td>

                <!-- Notes individuelles -->
                <td class="px-6 py-4 text-center">
                  <div class="flex flex-wrap justify-center gap-1">
                    <% g.notes.forEach(n => { %>
                      <span class="px-1.5 py-0.5 bg-slate-100 rounded text-xs font-semibold text-gray-700">
                        <%= n.valeur %>
                      </span>
                    <% }) %>
                  </div>
                </td>

                <!-- Moyenne Matière -->
                <td class="px-6 py-4 text-center">
                  <span class="font-bold text-sm <%= parseFloat(g.moyenne) >= 10 ? 'text-secondary' : 'text-red-500' %>">
                    <%= g.moyenne %>
                  </span>
                </td>

                <!-- Appréciation Matière -->
                <td class="px-6 py-4 text-xs text-gray-500 italic max-w-xs leading-relaxed">
                  <%= g.notes[g.notes.length - 1].appreciation || 'Ensemble satisfaisant.' %>
                </td>
              </tr>
            <% }) %>

            <% if (noteParMatiere.length === 0) { %>
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-gray-400">
                  <i class="fas fa-file-excel text-3xl mb-2 text-gray-300"></i>
                  <p class="font-medium text-sm">Aucune note enregistrée sur ce trimestre pour cet élève.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Résumé final des résultats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 border-t-2 border-slate-900 pt-6">
        
        <!-- Moyenne générale -->
        <div class="bg-slate-900 text-white p-5 rounded-2xl flex flex-col justify-between shadow-md">
          <span class="text-xs uppercase font-bold text-slate-400 tracking-wider">Moyenne Générale</span>
          <div class="mt-2 flex items-baseline">
            <span class="text-3xl font-extrabold tracking-tight">
              <%= bulletin.moyenne_generale || 'N/A' %>
            </span>
            <span class="ml-1 text-sm font-semibold text-slate-400">/ 20</span>
          </div>
          <span class="text-[10px] text-secondary font-semibold mt-1 flex items-center">
            <i class="fas fa-calculator mr-1"></i> Calculée automatiquement
          </span>
        </div>

        <!-- Décision du conseil -->
        <div class="bg-slate-50 border border-gray-200 p-5 rounded-2xl md:col-span-2 flex flex-col justify-between">
          <div>
            <span class="text-xs uppercase font-bold text-gray-400 tracking-wider block">Appréciation générale & décision</span>
            <p class="text-base font-bold text-gray-800 mt-2 leading-relaxed">
              <%= bulletin.appreciation_generale || 'Aucune appréciation enregistrée.' %>
            </p>
          </div>
          <div class="flex items-center space-x-1.5 text-xs text-slate-400 mt-4">
            <i class="fas fa-stamp text-slate-500"></i>
            <span>Cachet officiel et décision finale validés.</span>
          </div>
        </div>

      </div>

      <!-- Signatures (Invisible à l'écran, visible à l'impression) -->
      <div class="hidden print:grid grid-cols-2 gap-8 pt-12 mt-12 text-xs font-semibold text-center border-t border-dashed border-gray-300">
        <div>
          <p class="text-gray-500 mb-8">Le Professeur Titulaire</p>
          <p class="text-gray-900 border-b border-gray-900 pb-2 w-32 mx-auto"></p>
        </div>
        <div>
          <p class="text-gray-500 mb-8">Le Chef d'Établissement</p>
          <p class="text-gray-900 border-b border-gray-900 pb-2 w-32 mx-auto"></p>
        </div>
      </div>

    </div>
  <% } %>
</div>

<!-- Styles d'impression CSS spécifiques -->
<style>
  @media print {
    body {
      background-color: white !important;
      color: black !important;
    }
    nav, footer, .no-print, button {
      display: none !important;
    }
    main {
      padding: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
    }
    .print\:border-none {
      border: none !important;
    }
    .print\:shadow-none {
      box-shadow: none !important;
    }
    .print\:p-0 {
      padding: 0 !important;
    }
    .print\:grid {
      display: grid !important;
    }
  }
</style>
