<!-- views/professeur/devoirs.ejs -->
<div class="space-y-8 animate-fadeIn">
  
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Gestion des Devoirs (Cahier de textes)</h1>
      <p class="text-sm text-gray-500 mt-1">Publiez et planifiez les travaux de maison à rendre par vos classes.</p>
    </div>
    <div class="mt-4 md:mt-0">
      <a href="/professeur/dashboard" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
        <i class="fas fa-arrow-left mr-1"></i> Tableau de bord
      </a>
    </div>
  </div>

  <!-- Contenu Principal -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Liste des devoirs publiés (2/3 de l'écran) -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex justify-between items-center bg-gray-50/50">
        <h2 class="font-bold text-gray-800 flex items-center">
          <i class="fas fa-tasks text-primary mr-2"></i> Travaux publiés
        </h2>
        <span class="text-xs bg-blue-100 text-primary font-semibold px-2.5 py-0.5 rounded-full">
          <%= devoirs.length %> Devoirs enregistrés
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <% devoirs.forEach(d => { %>
          <div class="bg-white border border-gray-150 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
            
            <div class="space-y-3">
              <div class="flex justify-between items-start">
                <div class="flex flex-wrap gap-1.5">
                  <span class="px-2 py-0.5 bg-blue-50 text-blue-700 text-[10px] font-bold rounded uppercase">
                    <%= d.classe ? d.classe.nom : 'Classe' %>
                  </span>
                  <span class="px-2 py-0.5 bg-blue-50 text-primary text-[10px] font-bold rounded uppercase">
                    <%= d.matiere ? d.matiere.nom : 'Matière' %>
                  </span>
                </div>

                <!-- Actions modifier / supprimer -->
                <div class="flex space-x-1">
                  <button onclick="openEditDevoirModal('<%= d.id %>', '<%= d.titre %>', '<%= d.description %>', '<%= d.date_limite %>', '<%= d.classe_id %>', '<%= d.matiere_id %>', '<%= d.fichier || '' %>', '<%= d.fichier_nom || '' %>')"
                    class="w-7 h-7 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors flex items-center justify-center">
                    <i class="fas fa-edit text-xs"></i>
                  </button>
                  <form action="/professeur/devoirs/<%= d.id %>/delete" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce devoir ?')" class="inline">
                    <%- include('../partials/csrfField') %>
                    <button type="submit" class="w-7 h-7 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors flex items-center justify-center">
                      <i class="fas fa-trash-alt text-xs"></i>
                    </button>
                  </form>
                </div>
              </div>

              <h3 class="text-base font-bold text-gray-800"><%= d.titre %></h3>
              <p class="text-xs text-gray-500 leading-relaxed line-clamp-3">
                <%= d.description || 'Pas de consigne rédigée.' %>
              </p>
              <% if (d.fichier) { %>
                <div class="mt-2 flex items-center">
                  <a href="/uploads/<%= d.fichier %>" target="_blank" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-blue-50 hover:bg-blue-100 text-primary text-xs font-semibold rounded-lg border border-blue-200 transition-colors">
                    <i class="fas fa-paperclip"></i>
                    <%= d.fichier_nom || 'Fichier joint' %>
                  </a>
                </div>
              <% } %>
            </div>

            <div class="pt-4 mt-4 border-t border-gray-100 flex justify-between items-center text-[10px] text-gray-400">
              <span>Publié le : <%= new Date(d.date_publication).toLocaleDateString('fr-FR') %></span>
              <span class="font-bold text-red-600">À rendre : <%= new Date(d.date_limite).toLocaleDateString('fr-FR') %></span>
            </div>

          </div>
        <% }) %>

        <% if (devoirs.length === 0) { %>
          <div class="col-span-2 bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl p-12 text-center text-gray-500">
            <i class="fas fa-tasks text-4xl mb-3 text-gray-300"></i>
            <p class="font-medium text-sm">Vous n'avez publié aucun devoir pour le moment.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Panel de publication (1/3 de l'écran) -->
    <div class="space-y-6">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center">
          <i class="fas fa-plus-circle text-primary mr-2"></i> Publier un Devoir
        </h2>

        <form action="/professeur/devoirs" method="POST" enctype="multipart/form-data" class="space-y-4">
          
      <%- include('../partials/csrfField') %>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Titre du Devoir</label>
            <input type="text" name="titre" required placeholder="DM n°1 : Fonctions affines"
              class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary">
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Consignes / Description</label>
            <textarea name="description" rows="4" required placeholder="Faire les exercices 1, 2 et 3 page 45 du manuel de cours. Rédiger proprement sur copie double."
              class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Classe ciblée</label>
              <select name="classe_id" required
                class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary text-xs">
                <% classes.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.niveau %> — <%= c.nom %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Matière</label>
              <select name="matiere_id" required
                class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary text-xs">
                <% matieres.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.nom %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Date limite de rendu</label>
            <input type="date" name="date_limite" id="add-devoir-date" required
              class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-secondary font-mono">
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Fichier joint (optionnel)</label>
            <div class="relative">
              <input type="file" name="fichier" accept=".pdf,.docx,.jpg,.png"
                class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-primary hover:file:bg-blue-100 cursor-pointer">
            </div>
            <p class="text-[10px] text-gray-400 mt-1">Formats acceptés : PDF, DOCX, JPG, PNG (max 5 Mo)</p>
          </div>

          <button type="submit" 
            class="w-full py-3 bg-primary hover:bg-secondary text-white font-bold rounded-xl shadow-md transition-all">
            Publier le devoir
          </button>
        </form>
      </div>
    </div>

  </div>
</div>

<!-- Modal Modification Devoir -->
<div id="edit-devoir-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 transform scale-95 transition-all">
    <div class="flex items-center space-x-3 text-blue-600 mb-4">
      <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center">
        <i class="fas fa-edit text-lg"></i>
      </div>
      <h3 class="text-xl font-bold text-gray-900">Modifier le Devoir</h3>
    </div>

    <form id="edit-devoir-form" method="POST" class="space-y-4">
      <%- include('../partials/csrfField') %>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Titre du Devoir</label>
        <input type="text" name="titre" id="edit-devoir-titre" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
        <textarea name="description" id="edit-devoir-description" rows="4" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Classe</label>
          <select name="classe_id" id="edit-devoir-classe" required
            class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs">
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.niveau %> — <%= c.nom %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Matière</label>
          <select name="matiere_id" id="edit-devoir-matiere" required
            class="w-full rounded-xl border border-gray-300 px-3 py-2 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs">
            <% matieres.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.nom %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Date limite de rendu</label>
        <input type="date" name="date_limite" id="edit-devoir-date-limite" required
          class="w-full rounded-xl border border-gray-300 px-3 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Fichier joint (optionnel)</label>
        <div id="edit-devoir-fichier-info" class="mb-2 hidden">
          <span id="edit-devoir-fichier-nom" class="text-xs text-primary"></span>
        </div>
        <input type="file" name="fichier" accept=".pdf,.docx,.jpg,.png"
          class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-primary hover:file:bg-blue-100 cursor-pointer">
        <p class="text-[10px] text-gray-400 mt-1">Formats acceptés : PDF, DOCX, JPG, PNG (max 5 Mo)</p>
      </div>

      <div class="flex justify-end space-x-3 pt-2">
        <button type="button" onclick="closeEditDevoirModal()"
          class="px-4 py-2 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
          Annuler
        </button>
        <button type="submit"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-sm font-semibold transition-all">
          Enregistrer Modifications
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Initialiser la date limite par défaut à J+7
  const nextWeek = new Date();
  nextWeek.setDate(nextWeek.getDate() + 7);
  document.getElementById('add-devoir-date').value = nextWeek.toISOString().substring(0, 10);

  function openEditDevoirModal(devoirId, titre, description, dateLimite, classeId, matiereId, fichier, fichierNom) {
    document.getElementById('edit-devoir-titre').value = titre;
    document.getElementById('edit-devoir-description').value = description;
    document.getElementById('edit-devoir-date-limite').value = dateLimite;
    document.getElementById('edit-devoir-classe').value = classeId;
    document.getElementById('edit-devoir-matiere').value = matiereId;
    document.getElementById('edit-devoir-form').action = '/professeur/devoirs/' + devoirId + '/update';
    
    const fichierInfo = document.getElementById('edit-devoir-fichier-info');
    const fichierNomEl = document.getElementById('edit-devoir-fichier-nom');
    if (fichier && fichierNom) {
      fichierInfo.classList.remove('hidden');
      fichierNomEl.innerHTML = '<i class="fas fa-paperclip mr-1"></i>Fichier actuel : <a href="/uploads/' + fichier + '" target="_blank" class="underline">' + fichierNom + '</a>';
    } else {
      fichierInfo.classList.add('hidden');
    }
    
    document.getElementById('edit-devoir-modal').classList.remove('hidden');
  }

  function closeEditDevoirModal() {
    document.getElementById('edit-devoir-modal').classList.add('hidden');
  }
</script>
