<!-- views/professeur/emploiDuTemps.ejs -->
<div class="space-y-8 animate-fadeIn">
  
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4 no-print">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Mon Emploi du Temps</h1>
      <p class="text-sm text-gray-500 mt-1">Consultez votre calendrier d'enseignement hebdomadaire.</p>
    </div>
    <div class="mt-4 md:mt-0 space-x-2">
      <a href="/professeur/dashboard" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
        <i class="fas fa-arrow-left mr-1"></i> Tableau de bord
      </a>
      <button onclick="window.print()" class="px-4 py-2 bg-primary hover:bg-blue-800 text-white text-sm font-bold rounded-xl shadow-md transition-all inline-flex items-center">
        <i class="fas fa-print mr-1.5"></i> Imprimer
      </button>
    </div>
  </div>

  <!-- Grille hebdomadaire -->
  <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6 overflow-hidden">
    
    <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-100">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 bg-blue-50 text-primary rounded-xl flex items-center justify-center font-bold">
          <i class="fas fa-calendar-alt text-lg"></i>
        </div>
        <div>
          <h2 class="text-lg font-bold text-gray-800">Calendrier Hebdomadaire Enseignant</h2>
          <p class="text-xs text-gray-500">Planification des cours de la semaine</p>
        </div>
      </div>
      <span class="px-3 py-1 bg-blue-100 text-primary text-xs font-bold rounded-full uppercase tracking-wider">
        Actif (MySQL)
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-6 gap-4">
      <div class="md:col-span-6 mb-2 flex flex-wrap gap-2 text-xs text-amber-800 bg-amber-50 border border-amber-100 rounded-xl px-3 py-2">
        <i class="fas fa-coffee"></i>
        <span>Pauses : <% pauses.forEach((p,i)=>{ %><%= p.debut %>-<%= p.fin %><%= i<pauses.length-1?' · ':'' %><% }) %></span>
      </div>
      <% jours.forEach(jour => { %>
        <div class="bg-slate-50/50 p-4 rounded-2xl border border-gray-100 min-h-[220px] flex flex-col space-y-2">
          <span class="block text-center font-bold text-xs uppercase text-gray-400 tracking-wider pb-2 border-b border-gray-200">
            <%= jour %>
          </span>
          <% construireTimelineJour(planning[jour] || []).forEach(item => { %>
            <% if (item.type === 'pause') { %>
              <div class="bg-amber-50 border border-amber-200 border-dashed rounded-xl p-2 text-center">
                <span class="block text-[10px] font-bold text-amber-800"><%= item.label %></span>
                <span class="text-[10px] text-amber-700 font-mono"><%= item.debut %> – <%= item.fin %></span>
              </div>
            <% } else {
              const s = item.seance;
            %>
              <div class="bg-white p-3 rounded-xl border border-gray-100 shadow-sm relative overflow-hidden group">
                <div class="absolute left-0 top-0 bottom-0 w-1 bg-primary"></div>
                <span class="block text-[10px] font-bold text-gray-400 font-mono"><%= item.debut %> – <%= item.fin %></span>
                <h4 class="font-extrabold text-gray-900 text-xs"><%= s.matiere ? s.matiere.nom : 'Matière' %></h4>
                <div class="text-[10px] text-gray-500 mt-1 flex items-center space-x-1">
                  <i class="fas fa-school text-[9px]"></i>
                  <span class="font-semibold">
                    <% if (s.emploiDuTemps && s.emploiDuTemps.classe) { %>
                      <%= s.emploiDuTemps.classe.niveau %> <%= s.emploiDuTemps.classe.nom %>
                    <% } else { %>Classe<% } %>
                  </span>
                </div>
                <% if (s.salle) { %>
                  <span class="mt-1 inline-block px-2 py-0.5 bg-slate-100 text-slate-600 text-[9px] font-bold rounded font-mono">Salle <%= s.salle %></span>
                <% } %>
              </div>
            <% } %>
          <% }) %>
        </div>
      <% }) %>
    </div>

  </div>
</div>

<style>
  @media print {
    nav, footer, .no-print, button {
      display: none !important;
    }
    body {
      background-color: white !important;
      color: black !important;
    }
    main {
      padding: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
    }
  }
</style>
