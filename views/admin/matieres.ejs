<div class="space-y-6">
  <div class="flex justify-between border-b pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami">Matières</h1>
      <p class="text-sm text-gray-500">Coefficients et volumes horaires se configurent par classe.</p>
    </div>
    <a href="/admin/dashboard" class="text-sm text-gray-500">← Dashboard</a>
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 bg-white rounded-2xl border overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50"><tr>
          <th class="px-4 py-3 text-left text-xs uppercase">Nom</th>
          <th class="px-4 py-3 text-left text-xs uppercase">Code</th>
          <th class="px-4 py-3 text-left text-xs uppercase">Profs</th>
          <th class="px-4 py-3 text-right text-xs uppercase">Actions</th>
        </tr></thead>
        <tbody class="divide-y">
          <% matieres.forEach(m => { %>
          <tr>
            <td class="px-4 py-3 font-semibold"><%= m.nom %></td>
            <td class="px-4 py-3 text-gray-600"><%= m.code %></td>
            <td class="px-4 py-3"><%= m.nbProfs %></td>
            <td class="px-4 py-3 text-right space-x-2">
              <a href="/admin/matieres/<%= m.id %>/edit" class="text-secondary text-xs">Modifier</a>
              <form action="/admin/matieres/<%= m.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Supprimer cette matière ?')">
                <%- include('../partials/csrfField') %><button type="submit" class="text-red-600 text-xs">Suppr.</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="bg-white rounded-2xl border p-6">
      <h2 class="font-bold mb-4">Nouvelle matière</h2>
      <form action="/admin/matieres/create" method="POST" class="space-y-3">
        <%- include('../partials/csrfField') %>
        <input type="text" name="nom" required maxlength="50" placeholder="Nom (ex: Mathématiques)" class="w-full rounded-xl border px-3 py-2" />
        <input type="text" name="code" placeholder="Code (optionnel, ex: MATH)" class="w-full rounded-xl border px-3 py-2" />
        <textarea name="description" rows="2" placeholder="Description (optionnel)" class="w-full rounded-xl border px-3 py-2"></textarea>
        <button type="submit" class="w-full py-3 bg-primary text-white font-bold rounded-xl">Créer</button>
      </form>
    </div>
  </div>
</div>
