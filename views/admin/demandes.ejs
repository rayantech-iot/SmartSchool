<div class="space-y-6">
  <div class="flex justify-between border-b pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami">Demandes & inscriptions</h1>
      <p class="text-sm text-gray-500">Validations parent ↔ élève et nouvelles inscriptions élèves</p>
    </div>
    <a href="/admin/dashboard" class="text-sm text-gray-500">← Dashboard</a>
  </div>

  <% if (inscriptionsEleves && inscriptionsEleves.length) { %>
  <div class="bg-white rounded-2xl border overflow-hidden">
    <div class="px-4 py-3 bg-amber-50 border-b font-bold text-amber-900">
      <i class="fas fa-user-graduate mr-1"></i> Inscriptions élèves en attente (<%= inscriptionsEleves.length %>)
    </div>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50"><tr>
        <th class="px-4 py-3 text-left text-xs uppercase">Élève</th>
        <th class="px-4 py-3 text-left text-xs uppercase">Email</th>
        <th class="px-4 py-3 text-left text-xs uppercase">Matricule</th>
        <th class="px-4 py-3 text-right text-xs uppercase">Actions</th>
      </tr></thead>
      <tbody class="divide-y">
        <% inscriptionsEleves.forEach(u => { const e = u.profilEleve; %>
        <tr>
          <td class="px-4 py-3 font-semibold"><%= u.prenom %> <%= u.nom %></td>
          <td class="px-4 py-3"><%= u.email %></td>
          <td class="px-4 py-3"><%= e ? e.matricule : '—' %></td>
          <td class="px-4 py-3 text-right">
            <form action="/admin/inscriptions-eleve/<%= u.id %>/activer" method="POST" class="inline-flex items-center gap-2">
              <%- include('../partials/csrfField') %>
              <select name="classe_id" class="rounded-lg border text-xs px-2 py-1">
                <option value="">— Classe —</option>
                <% if (typeof classes !== 'undefined') classes.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.niveau %> <%= c.nom %></option>
                <% }) %>
              </select>
              <button type="submit" class="px-3 py-1 bg-primary text-white rounded-lg text-xs font-semibold">Activer</button>
            </form>
            <form action="/admin/inscriptions-eleve/<%= u.id %>/refuser" method="POST" class="inline ml-1">
              <%- include('../partials/csrfField') %>
              <button type="submit" class="px-3 py-1 text-red-600 text-xs">Refuser</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <div class="bg-white rounded-2xl border overflow-hidden">
    <div class="px-4 py-3 bg-blue-50 border-b font-bold text-primary">
      <i class="fas fa-link mr-1"></i> Demandes de liaison parent ↔ élève
    </div>
    <% if (!demandes.length) { %>
      <p class="p-8 text-center text-gray-400">Aucune demande en attente.</p>
    <% } else { %>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50"><tr>
        <th class="px-4 py-3 text-left text-xs uppercase">Email parent</th>
        <th class="px-4 py-3 text-left text-xs uppercase">Élève</th>
        <th class="px-4 py-3 text-left text-xs uppercase">Matricule</th>
        <th class="px-4 py-3 text-left text-xs uppercase">Lien</th>
        <th class="px-4 py-3 text-right text-xs uppercase">Actions</th>
      </tr></thead>
      <tbody class="divide-y">
        <% demandes.forEach(d => { %>
        <tr>
          <td class="px-4 py-3"><%= d.utilisateur ? d.utilisateur.email : d.email %></td>
          <td class="px-4 py-3"><%= d.eleve && d.eleve.utilisateur ? d.eleve.utilisateur.prenom + ' ' + d.eleve.utilisateur.nom : '—' %></td>
          <td class="px-4 py-3 font-mono"><%= d.matricule %></td>
          <td class="px-4 py-3"><%= d.lien %></td>
          <td class="px-4 py-3 text-right space-x-2">
            <form action="/admin/demandes/<%= d.id %>/valider" method="POST" class="inline">
              <%- include('../partials/csrfField') %>
              <button type="submit" class="px-3 py-1 bg-green-600 text-white rounded-lg text-xs">Valider</button>
            </form>
            <form action="/admin/demandes/<%= d.id %>/refuser" method="POST" class="inline">
              <%- include('../partials/csrfField') %>
              <button type="submit" class="px-3 py-1 text-red-600 text-xs">Refuser</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
