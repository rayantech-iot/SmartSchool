<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between border-b pb-4">
    <h1 class="text-2xl font-bold font-alkalami"><%= mode === 'create' ? 'Nouvel utilisateur' : 'Modifier utilisateur' %></h1>
    <a href="/admin/utilisateurs" class="text-sm text-secondary hover:underline">← Retour</a>
  </div>

  <form id="form-utilisateur" action="<%= mode === 'create' ? '/admin/utilisateurs/create' : '/admin/utilisateurs/' + utilisateur.id + '/update' %>" method="POST" class="bg-white rounded-2xl border p-6 space-y-5">
    <%- include('../partials/csrfField') %>

    <!-- Infos communes -->
    <div class="space-y-4">
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Identité</p>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="block text-sm font-semibold mb-1">Nom *</label><input type="text" name="nom" required maxlength="50" value="<%= utilisateur ? utilisateur.nom : '' %>" class="w-full rounded-xl border px-3 py-2" /></div>
        <div><label class="block text-sm font-semibold mb-1">Prénom *</label><input type="text" name="prenom" required maxlength="50" value="<%= utilisateur ? utilisateur.prenom : '' %>" class="w-full rounded-xl border px-3 py-2" /></div>
      </div>
      <div><label class="block text-sm font-semibold mb-1">Email *</label><input type="email" name="email" required value="<%= utilisateur ? utilisateur.email : '' %>" class="w-full rounded-xl border px-3 py-2" /></div>
      <div><label class="block text-sm font-semibold mb-1">Téléphone</label><input type="text" name="telephone" value="<%= utilisateur ? utilisateur.telephone || '' : '' %>" class="w-full rounded-xl border px-3 py-2" /></div>
    </div>

    <% if (mode === 'create') { %>
    <!-- Choix du rôle -->
    <div class="space-y-3">
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider">Rôle *</p>
      <select name="type" id="role-select" required class="w-full rounded-xl border px-3 py-2.5 bg-white font-semibold text-primary">
        <option value="">— Choisir un rôle —</option>
        <option value="professeur">Professeur</option>
        <option value="eleve">Élève</option>
        <option value="parent">Parent</option>
        <option value="admin">Administrateur</option>
      </select>
      <div id="role-hint" class="hidden text-sm rounded-xl px-4 py-3 border bg-blue-50 border-blue-100 text-blue-900"></div>
    </div>

    <div id="f-mdp" class="hidden space-y-1">
      <label class="block text-sm font-semibold mb-1">Mot de passe</label>
      <input type="password" name="motDePasse" minlength="8" placeholder="Min. 8 caractères — laisser vide = invitation par email" class="w-full rounded-xl border px-3 py-2" />
      <p id="mdp-hint" class="text-xs text-gray-500"></p>
    </div>
    <% } else { %>
    <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-xl border">
      <span class="text-xs text-gray-500 uppercase font-bold">Rôle</span>
      <span class="px-2 py-0.5 bg-primary text-white text-xs font-bold rounded-full capitalize"><%= utilisateur.type %></span>
    </div>
    <div><label class="block text-sm font-semibold mb-1">Nouveau mot de passe (optionnel, min. 8 car.)</label>
      <input type="password" name="nouveauMotDePasse" minlength="8" class="w-full rounded-xl border px-3 py-2" /></div>
    <% } %>

    <!-- Panneau Professeur -->
    <div id="f-prof" data-role="professeur" class="role-panel hidden space-y-4 border-t pt-4">
      <p class="text-sm font-bold text-primary"><i class="fas fa-chalkboard-teacher mr-1"></i> Informations professeur</p>
      <div><label class="block text-sm font-semibold mb-1">Grade *</label><input type="text" name="grade" data-req="professeur" value="<%= profil && profil.grade ? profil.grade : '' %>" placeholder="Certifié, Agrégé, Vacataire..." class="w-full rounded-xl border px-3 py-2" /></div>
      <div><label class="block text-sm font-semibold mb-1">Spécialité</label><input type="text" name="specialite" value="<%= profil && profil.specialite ? profil.specialite : '' %>" class="w-full rounded-xl border px-3 py-2" /></div>
      <div><label class="block text-sm font-semibold mb-1">Matières enseignées</label>
        <div class="border rounded-xl p-2 max-h-36 overflow-y-auto space-y-1">
          <% if (matieres.length) { matieres.forEach(m => { %>
          <label class="flex text-sm items-center"><input type="checkbox" name="matieres" value="<%= m.id %>" <%= profMatieres && profMatieres.includes(m.id) ? 'checked' : '' %> class="mr-2" /><%= m.nom %></label>
          <% }) } else { %><p class="text-xs text-gray-400 italic p-2">Aucune matière — créez-en dans l'onglet Matières.</p><% } %>
        </div></div>
      <div><label class="block text-sm font-semibold mb-1">Classes affectées</label>
        <div class="border rounded-xl p-2 max-h-36 overflow-y-auto space-y-1">
          <% if (classes.length) { classes.forEach(c => { %>
          <label class="flex text-sm items-center"><input type="checkbox" name="classes" value="<%= c.id %>" <%= profClasses && profClasses.includes(c.id) ? 'checked' : '' %> class="mr-2" /><%= c.niveau %> <%= c.nom %></label>
          <% }) } else { %><p class="text-xs text-gray-400 italic p-2">Aucune classe disponible.</p><% } %>
        </div></div>
    </div>

    <!-- Panneau Élève -->
    <div id="f-eleve" data-role="eleve" class="role-panel hidden space-y-4 border-t pt-4">
      <p class="text-sm font-bold text-primary"><i class="fas fa-user-graduate mr-1"></i> Informations élève</p>
      <div><label class="block text-sm font-semibold mb-1">Date de naissance *</label><input type="date" name="date_naissance" data-req="eleve" value="<%= profil && profil.date_naissance ? profil.date_naissance : '' %>" class="w-full rounded-xl border px-3 py-2" /></div>
      <div><label class="block text-sm font-semibold mb-1">Matricule</label><input type="text" name="matricule" value="<%= profil && profil.matricule ? profil.matricule : '' %>" placeholder="Généré automatiquement si vide" class="w-full rounded-xl border px-3 py-2 uppercase" /></div>
      <div><label class="block text-sm font-semibold mb-1">Classe *</label>
        <select name="classe_id" data-req="eleve" class="w-full rounded-xl border px-3 py-2 bg-white">
          <option value="">— Choisir une classe —</option>
          <% classes.forEach(c => { %><option value="<%= c.id %>" <%= profil && profil.classe_id == c.id ? 'selected' : '' %>><%= c.niveau %> <%= c.nom %></option><% }) %>
        </select></div>
      <% if (mode === 'create') { %>
      <div class="bg-amber-50 border border-amber-100 rounded-xl p-4 space-y-3">
        <p class="text-sm font-bold text-amber-900"><i class="fas fa-envelope mr-1"></i> Parents — invitation par email</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div><label class="block text-xs font-semibold mb-1">Email parent 1</label><input type="email" name="parent_email" placeholder="parent@exemple.tg" class="w-full rounded-xl border px-3 py-2 text-sm" /></div>
          <div><label class="block text-xs font-semibold mb-1">Lien</label>
            <select name="parent_lien" class="w-full rounded-xl border px-3 py-2 bg-white text-sm">
              <option value="père">Père</option><option value="mère">Mère</option><option value="tuteur" selected>Tuteur</option>
            </select></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div><label class="block text-xs font-semibold mb-1">Email parent 2 (optionnel)</label><input type="email" name="parent_email_2" class="w-full rounded-xl border px-3 py-2 text-sm" /></div>
          <div><label class="block text-xs font-semibold mb-1">Lien</label>
            <select name="parent_lien_2" class="w-full rounded-xl border px-3 py-2 bg-white text-sm">
              <option value="père">Père</option><option value="mère">Mère</option><option value="tuteur" selected>Tuteur</option>
            </select></div>
        </div>
        <p class="text-xs text-amber-800">L'élève et chaque parent recevront un email pour créer leur mot de passe (lien 48 h).</p>
      </div>
      <% } %>
    </div>

    <!-- Panneau Parent -->
    <div id="f-parent" data-role="parent" class="role-panel hidden space-y-4 border-t pt-4">
      <p class="text-sm font-bold text-primary"><i class="fas fa-users mr-1"></i> Informations parent</p>
      <div><label class="block text-sm font-semibold mb-1">Enfant lié *</label>
        <select name="eleve_id" data-req="parent" class="w-full rounded-xl border px-3 py-2 bg-white">
          <option value="">— Choisir l'élève —</option>
          <% eleves.forEach(e => { %><option value="<%= e.id %>" <%= profil && profil.eleve_id == e.id ? 'selected' : '' %>><%= e.utilisateur ? e.utilisateur.prenom + ' ' + e.utilisateur.nom : 'Élève #'+e.id %><%= e.matricule ? ' ('+e.matricule+')' : '' %></option><% }) %>
        </select></div>
      <div><label class="block text-sm font-semibold mb-1">Lien de parenté *</label>
        <select name="lien" data-req="parent" class="w-full rounded-xl border px-3 py-2 bg-white">
          <option value="père" <%= profil && profil.lien === 'père' ? 'selected' : '' %>>Père</option>
          <option value="mère" <%= profil && profil.lien === 'mère' ? 'selected' : '' %>>Mère</option>
          <option value="tuteur" <%= profil && profil.lien === 'tuteur' ? 'selected' : '' %>>Tuteur</option>
        </select></div>
      <div><label class="block text-sm font-semibold mb-1">Profession</label><input type="text" name="profession" value="<%= profil && profil.profession ? profil.profession : '' %>" class="w-full rounded-xl border px-3 py-2" /></div>
    </div>

    <!-- Panneau Admin -->
    <div id="f-admin" data-role="admin" class="role-panel hidden space-y-4 border-t pt-4">
      <p class="text-sm font-bold text-primary"><i class="fas fa-user-shield mr-1"></i> Informations administrateur</p>
      <div><label class="block text-sm font-semibold mb-1">Niveau d'accès *</label>
        <select name="niveau_acces" data-req="admin" class="w-full rounded-xl border px-3 py-2 bg-white">
          <option value="1" <%= profil && profil.niveau_acces === 'admin' ? 'selected' : '' %>>Admin — gestion courante</option>
          <option value="2" <%= profil && profil.niveau_acces === 'super_admin' ? 'selected' : '' %>>Super admin — accès complet</option>
        </select></div>
    </div>

    <button type="submit" id="btn-submit" class="w-full py-3 bg-primary text-white font-bold rounded-xl opacity-50 cursor-not-allowed" disabled>
      <%= mode === 'create' ? 'Créer l\'utilisateur' : 'Enregistrer' %>
    </button>
  </form>
</div>

<script>
(function () {
  const MODE = '<%= mode %>';
  const EDIT_ROLE = '<%= utilisateur ? utilisateur.type : "" %>';

  const HINTS = {
    professeur: 'Configurez le grade, les matières et les classes. Un email d\'activation sera envoyé si aucun mot de passe n\'est saisi.',
    eleve: 'Renseignez la classe et les emails des parents. L\'élève recevra un email pour créer son mot de passe.',
    parent: 'Liez le parent à un élève existant. Un email d\'activation sera envoyé automatiquement.',
    admin: 'Définissez le niveau d\'accès. Un email d\'activation sera envoyé si aucun mot de passe n\'est saisi.'
  };

  const MDP_HINTS = {
    professeur: 'Laisser vide → email d\'activation (48 h).',
    admin: 'Laisser vide → email d\'activation (48 h).',
    eleve: '',
    parent: ''
  };

  function getRole() {
    if (MODE === 'edit') return EDIT_ROLE;
    return document.getElementById('role-select')?.value || '';
  }

  function setPanelEnabled(panel, enabled) {
    if (!panel) return;
    panel.querySelectorAll('input, select, textarea').forEach(el => {
      if (el.name === 'type') return;
      el.disabled = !enabled;
    });
  }

  function applyRole(role) {
    document.querySelectorAll('.role-panel').forEach(panel => {
      const match = panel.dataset.role === role;
      panel.classList.toggle('hidden', !match);
      setPanelEnabled(panel, match);
    });

    document.querySelectorAll('[data-req]').forEach(el => {
      const panel = el.closest('.role-panel');
      const visible = panel && !panel.classList.contains('hidden');
      el.required = visible && el.dataset.req === role;
    });

    const hint = document.getElementById('role-hint');
    if (hint) {
      if (role && HINTS[role]) {
        hint.textContent = HINTS[role];
        hint.classList.remove('hidden');
      } else {
        hint.classList.add('hidden');
      }
    }

    const mdpBox = document.getElementById('f-mdp');
    const mdpHint = document.getElementById('mdp-hint');
    if (mdpBox) {
      const showMdp = role === 'professeur' || role === 'admin';
      mdpBox.classList.toggle('hidden', !showMdp);
      if (mdpHint) mdpHint.textContent = MDP_HINTS[role] || '';
    }

    const btn = document.getElementById('btn-submit');
    if (btn && MODE === 'create') {
      const ok = !!role;
      btn.disabled = !ok;
      btn.classList.toggle('opacity-50', !ok);
      btn.classList.toggle('cursor-not-allowed', !ok);
    }
  }

  const roleSelect = document.getElementById('role-select');
  if (roleSelect) {
    roleSelect.addEventListener('change', () => applyRole(roleSelect.value));
  }

  if (MODE === 'edit' && EDIT_ROLE) {
    applyRole(EDIT_ROLE);
    const btn = document.getElementById('btn-submit');
    if (btn) { btn.disabled = false; btn.classList.remove('opacity-50', 'cursor-not-allowed'); }
  } else if (roleSelect) {
    applyRole(roleSelect.value);
  }
})();
</script>
