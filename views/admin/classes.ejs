<div class="space-y-6">
  <div class="flex justify-between items-center border-b pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami">Classes</h1>
      <p class="text-sm text-gray-500">Année scolaire <strong><%= anneeScolaire %></strong> — sections et salles automatiques</p>
    </div>
    <a href="/admin/dashboard" class="text-sm text-gray-500">← Dashboard</a>
  </div>

  <form method="GET" class="flex flex-wrap gap-3 bg-white p-4 rounded-xl border">
    <select name="cycle" class="rounded-xl border px-3 py-2 text-sm">
      <option value="">Tous les cycles</option>
      <% Object.entries(cycles).sort((a,b)=>a[1].ordre-b[1].ordre).forEach(([key, c]) => { %>
        <option value="<%= key %>" <%= filtreCycle === key ? 'selected' : '' %>><%= c.label %></option>
      <% }) %>
    </select>
    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-xl text-sm">Filtrer</button>
  </form>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="xl:col-span-2 bg-white rounded-2xl border overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50"><tr>
          <th class="px-4 py-3 text-left text-xs uppercase">Classe</th>
          <th class="px-4 py-3 text-left text-xs uppercase">Cycle</th>
          <th class="px-4 py-3 text-left text-xs uppercase">Salle</th>
          <th class="px-4 py-3 text-left text-xs uppercase">Effectif</th>
          <th class="px-4 py-3 text-left text-xs uppercase">Matières</th>
          <th class="px-4 py-3 text-right text-xs uppercase">Actions</th>
        </tr></thead>
        <tbody class="divide-y">
          <% classes.forEach(c => {
            const n = c.eleves ? c.eleves.length : 0;
            const plein = n >= c.capacite;
            const cycleLabel = cycles[c.cycle]?.label || c.cycle;
          %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-semibold"><%= c.niveau %> <%= c.nom %></td>
            <td class="px-4 py-3"><%= cycleLabel %></td>
            <td class="px-4 py-3 text-gray-600"><%= c.salle %></td>
            <td class="px-4 py-3">
              <%= n %>/<%= c.capacite %>
              <% if (plein) { %><span class="ml-1 px-2 py-0.5 bg-red-100 text-red-700 text-xs rounded-full font-semibold">Complet</span><% } %>
            </td>
            <td class="px-4 py-3"><%= c.matieres?.length || 0 %></td>
            <td class="px-4 py-3 text-right space-x-2">
              <button type="button" onclick="openMatieres(<%= c.id %>)" class="text-secondary hover:underline text-xs">Matières</button>
              <form action="/admin/classes/<%= c.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Supprimer <%= c.niveau %> <%= c.nom %> ?')">
                <%- include('../partials/csrfField') %>
                <button type="submit" class="text-red-600 text-xs">Supprimer</button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (!classes.length) { %>
          <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">Aucune classe pour cette année.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="bg-white rounded-2xl border p-6 space-y-4">
      <h2 class="font-bold"><i class="fas fa-plus-circle text-primary mr-1"></i> Nouvelle classe</h2>
      <form action="/admin/classes/create" method="POST" id="form-create-classe" class="space-y-3">
        <%- include('../partials/csrfField') %>

        <div>
          <label class="text-xs font-semibold text-gray-500 uppercase">1. Cycle</label>
          <select name="cycle" id="sel-cycle" required class="w-full rounded-xl border px-3 py-2 mt-1">
            <option value="">— Choisir —</option>
            <% Object.entries(cycles).sort((a,b)=>a[1].ordre-b[1].ordre).forEach(([key, c]) => { %>
              <option value="<%= key %>"><%= c.label %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="text-xs font-semibold text-gray-500 uppercase">2. Niveau</label>
          <select name="niveau" id="sel-niveau" required disabled class="w-full rounded-xl border px-3 py-2 mt-1">
            <option value="">— Choisir le cycle d'abord —</option>
          </select>
        </div>

        <div id="apercu-box" class="hidden bg-blue-50 border border-blue-100 rounded-xl p-3 text-sm space-y-1">
          <p><strong>Aperçu :</strong> <span id="apercu-libelle">—</span></p>
          <p>Section : <span id="apercu-section">—</span> · Salle : <span id="apercu-salle">—</span></p>
          <p>Capacité max. : <strong id="apercu-capacite">—</strong> élèves</p>
          <p class="text-xs text-gray-500">Année : <%= anneeScolaire %></p>
        </div>

        <div id="matieres-box" class="hidden space-y-2">
          <label class="text-xs font-semibold text-gray-500 uppercase">3. Matières enseignées</label>
          <% if (!toutesMatieres.length) { %>
            <p class="text-xs text-amber-700">Créez d'abord des matières dans l'onglet Matières.</p>
          <% } %>
          <% toutesMatieres.forEach(m => { %>
          <div class="border rounded-xl p-2 flex flex-wrap items-center gap-2 text-xs">
            <label class="flex items-center gap-2 flex-1 min-w-[120px]">
              <input type="checkbox" name="matieres" value="<%= m.id %>" class="mat-check" />
              <span class="font-semibold"><%= m.nom %></span>
            </label>
            <label>Coef. <input type="number" name="coef_<%= m.id %>" min="1" max="9" step="0.5" value="2" class="w-14 rounded border px-1 py-0.5" disabled /></label>
            <label>h/sem. <input type="number" name="vol_<%= m.id %>" min="1" max="20" value="2" class="w-14 rounded border px-1 py-0.5" disabled /></label>
          </div>
          <% }) %>
        </div>

        <button type="submit" id="btn-create" disabled class="w-full py-3 bg-primary text-white font-bold rounded-xl opacity-50 cursor-not-allowed">Créer la classe</button>
      </form>
    </div>
  </div>
</div>

<% classes.forEach(c => { %>
<div id="modal-mat-<%= c.id %>" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl p-6 max-w-lg w-full max-h-[90vh] overflow-y-auto">
    <h3 class="font-bold text-lg mb-4">Matières — <%= c.niveau %> <%= c.nom %></h3>
    <form action="/admin/classes/<%= c.id %>/matieres" method="POST" class="space-y-2">
      <%- include('../partials/csrfField') %>
      <% toutesMatieres.forEach(m => {
        const link = (c.matieres || []).find(x => x.id === m.id);
        const checked = !!link;
        const coef = link?.ClasseMatiere?.coefficient ?? 2;
        const vol = link?.ClasseMatiere?.volume_horaire_hebdo ?? 2;
      %>
      <div class="border rounded-xl p-2 flex flex-wrap items-center gap-2 text-xs">
        <label class="flex items-center gap-2 flex-1">
          <input type="checkbox" name="matieres" value="<%= m.id %>" <%= checked ? 'checked' : '' %> />
          <span class="font-semibold"><%= m.nom %></span>
        </label>
        <label>Coef. <input type="number" name="coef_<%= m.id %>" min="1" max="9" step="0.5" value="<%= coef %>" class="w-14 rounded border px-1" /></label>
        <label>h/sem. <input type="number" name="vol_<%= m.id %>" min="1" max="20" value="<%= vol %>" class="w-14 rounded border px-1" /></label>
      </div>
      <% }) %>
      <div class="flex justify-end gap-2 pt-4">
        <button type="button" onclick="closeMatieres(<%= c.id %>)" class="px-4 py-2 border rounded-xl text-sm">Annuler</button>
        <button type="submit" class="px-4 py-2 bg-primary text-white rounded-xl text-sm font-semibold">Enregistrer</button>
      </div>
    </form>
  </div>
</div>
<% }) %>

<script>
  const CYCLES = <%- JSON.stringify(cycles) %>;
  const selCycle = document.getElementById('sel-cycle');
  const selNiveau = document.getElementById('sel-niveau');
  const apercuBox = document.getElementById('apercu-box');
  const matieresBox = document.getElementById('matieres-box');
  const btnCreate = document.getElementById('btn-create');

  function openMatieres(id) { document.getElementById('modal-mat-' + id).classList.remove('hidden'); }
  function closeMatieres(id) { document.getElementById('modal-mat-' + id).classList.add('hidden'); }

  selCycle.addEventListener('change', () => {
    const cycle = selCycle.value;
    selNiveau.innerHTML = '<option value="">— Choisir —</option>';
    selNiveau.disabled = !cycle;
    apercuBox.classList.add('hidden');
    matieresBox.classList.add('hidden');
    btnCreate.disabled = true;
    btnCreate.classList.add('opacity-50', 'cursor-not-allowed');
    if (cycle && CYCLES[cycle]) {
      CYCLES[cycle].niveaux.forEach(n => {
        const o = document.createElement('option');
        o.value = n; o.textContent = n;
        selNiveau.appendChild(o);
      });
    }
  });

  async function refreshApercu() {
    const cycle = selCycle.value, niveau = selNiveau.value;
    if (!cycle || !niveau) return;
    const res = await fetch(`/admin/classes/apercu?cycle=${encodeURIComponent(cycle)}&niveau=${encodeURIComponent(niveau)}`);
    const data = await res.json();
    if (data.error) { alert(data.error); return; }
    document.getElementById('apercu-libelle').textContent = data.libelle;
    document.getElementById('apercu-section').textContent = data.section;
    document.getElementById('apercu-salle').textContent = data.salle;
    document.getElementById('apercu-capacite').textContent = data.capacite;
    apercuBox.classList.remove('hidden');
    matieresBox.classList.remove('hidden');
    btnCreate.disabled = false;
    btnCreate.classList.remove('opacity-50', 'cursor-not-allowed');
  }

  selNiveau.addEventListener('change', refreshApercu);

  document.querySelectorAll('.mat-check').forEach(cb => {
    cb.addEventListener('change', () => {
      const row = cb.closest('.border');
      row.querySelectorAll('input[type=number]').forEach(i => { i.disabled = !cb.checked; });
    });
  });
</script>
