<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="SmartSchool — Système Digital de Gestion et de Communication Scolaire pour les établissements scolaires du Togo" />
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
    <meta name="csrf-token" content="<%= csrfToken %>" />
  <% } %>
  <title><%= typeof titre !== 'undefined' ? titre : 'SmartSchool' %></title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Alkalami&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#1E3A8A',
            secondary: '#3B82F6',
            background: '#F3F4F6',
            textDark: '#374151'
          },
          fontFamily: {
            alkalami: ['Alkalami', 'serif'],
            roboto: ['Roboto', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Styles personnalisés SmartSchool -->
  <link rel="stylesheet" href="/css/style.css" />
</head>
<%
  const libellesRole = {
    admin: 'Administrateur',
    professeur: 'Professeur',
    eleve: 'Élève',
    parent: 'Parent'
  };
%>
<body class="bg-background font-roboto text-textDark min-h-screen flex flex-col"<% if (user) { %> data-user-type="<%= user.type %>"<% } %>>

  <!-- ===== NAVBAR ===== -->
  <nav class="bg-primary shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-[auto_1fr_auto] items-center h-16 gap-2 md:gap-4">

        <!-- Logo (gauche) -->
        <a href="/<%= user ? user.type : '' %>/dashboard" class="flex items-center shrink-0 group" title="SmartSchool">
          <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-md group-hover:scale-105 transition-transform overflow-hidden">
            <img src="/images/logo.svg" alt="SmartSchool" class="w-8 h-8" onerror="this.style.display='none';this.nextElementSibling.style.display='block'" />
            <i class="fas fa-graduation-cap text-primary text-lg hidden"></i>
          </div>
        </a>

        <!-- Onglets (centre) -->
        <div class="hidden md:flex items-center justify-center flex-wrap space-x-1">
          <% if (user && user.type === 'admin') { %>
            <a href="/admin/dashboard" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'nav-active' : '' %>"><i class="fas fa-tachometer-alt mr-1"></i>Tableau de bord</a>
            <a href="/admin/utilisateurs" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'utilisateurs' ? 'nav-active' : '' %>"><i class="fas fa-users mr-1"></i>Utilisateurs</a>
            <a href="/admin/demandes" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'demandes' ? 'nav-active' : '' %>"><i class="fas fa-user-check mr-1"></i>Demandes</a>
            <a href="/admin/classes" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'classes' ? 'nav-active' : '' %>"><i class="fas fa-school mr-1"></i>Classes</a>
            <a href="/admin/matieres" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'matieres' ? 'nav-active' : '' %>"><i class="fas fa-book mr-1"></i>Matières</a>
            <a href="/admin/emploiDuTemps" class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'emploiDuTemps' ? 'nav-active' : '' %>"><i class="fas fa-calendar-alt mr-1"></i>Emploi du temps</a>
          <% } else if (user && user.type === 'professeur') { %>
            <a href="/professeur/dashboard" class="nav-link"><i class="fas fa-tachometer-alt mr-1"></i>Tableau de bord</a>
            <a href="/professeur/notes" class="nav-link"><i class="fas fa-star mr-1"></i>Notes</a>
            <a href="/professeur/presences" class="nav-link"><i class="fas fa-clipboard-check mr-1"></i>Présences</a>
            <a href="/professeur/devoirs" class="nav-link"><i class="fas fa-tasks mr-1"></i>Devoirs</a>
            <a href="/professeur/emploiDuTemps" class="nav-link"><i class="fas fa-calendar mr-1"></i>Emploi du temps</a>
            <a href="/professeur/messages" class="nav-link relative">
              <i class="fas fa-envelope mr-1"></i>Messages
              <span id="badge-nonlus" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"></span>
            </a>
          <% } else if (user && user.type === 'eleve') { %>
            <a href="/eleve/dashboard" class="nav-link"><i class="fas fa-home mr-1"></i>Mon espace</a>
            <a href="/eleve/notes" class="nav-link"><i class="fas fa-star mr-1"></i>Mes notes</a>
            <a href="/eleve/devoirs" class="nav-link"><i class="fas fa-tasks mr-1"></i>Devoirs</a>
            <a href="/eleve/presences" class="nav-link"><i class="fas fa-calendar-check mr-1"></i>Présences</a>
            <a href="/eleve/documents" class="nav-link"><i class="fas fa-folder mr-1"></i>Documents</a>
            <a href="/eleve/emploiDuTemps" class="nav-link"><i class="fas fa-calendar mr-1"></i>Emploi du temps</a>
            <a href="/eleve/messages" class="nav-link relative">
              <i class="fas fa-envelope mr-1"></i>Messages
              <span id="badge-nonlus" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"></span>
            </a>
          <% } else if (user && user.type === 'parent') { %>
            <a href="/parent/dashboard" class="nav-link"><i class="fas fa-home mr-1"></i>Tableau de bord</a>
            <a href="/parent/bulletin" class="nav-link"><i class="fas fa-file-alt mr-1"></i>Bulletins</a>
            <a href="/parent/absences" class="nav-link"><i class="fas fa-calendar-times mr-1"></i>Absences</a>
            <a href="/parent/messages" class="nav-link relative">
              <i class="fas fa-envelope mr-1"></i>Messages
              <span id="badge-nonlus" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"></span>
            </a>
            <a href="/parent/emploiDuTemps" class="nav-link"><i class="fas fa-calendar mr-1"></i>Emploi du temps</a>
          <% } %>
        </div>

        <!-- Utilisateur + actions (droite) -->
        <div class="flex items-center justify-end gap-1 sm:gap-2">
          <% if (user) { %>
            <button type="button" id="btn-notifications" title="Notifications" class="relative text-white/90 hover:text-white p-2 rounded-lg hover:bg-white/10">
              <i class="fas fa-bell text-lg"></i>
              <span id="badge-notifications" class="hidden absolute top-0 right-0 bg-red-500 text-white text-[10px] font-bold rounded-full min-w-[1rem] h-4 px-1 flex items-center justify-center"></span>
            </button>
            <div id="notif-panel" class="hidden fixed right-4 top-[4.25rem] w-80 max-w-[calc(100vw-2rem)] bg-white rounded-xl shadow-2xl border border-gray-200 z-[60] overflow-hidden">
              <div class="px-4 py-3 bg-primary text-white font-semibold text-sm flex justify-between items-center">
                <span>Notifications</span>
                <button type="button" id="notif-panel-close" class="text-white/80 hover:text-white"><i class="fas fa-times"></i></button>
              </div>
              <ul id="notif-list" class="max-h-72 overflow-y-auto divide-y divide-gray-100 text-sm text-gray-700">
                <li class="p-4 text-gray-400 italic">Chargement…</li>
              </ul>
            </div>
            <div class="hidden sm:block text-right leading-tight max-w-[140px] lg:max-w-[200px]">
              <p class="text-white text-sm font-medium truncate"><%= user.prenom %> <%= user.nom %></p>
              <p class="text-white/65 text-xs truncate"><%= libellesRole[user.type] || user.type %></p>
            </div>
            <a href="/logout" class="flex items-center justify-center bg-red-600 hover:bg-red-700 text-white w-9 h-9 sm:w-auto sm:h-auto sm:px-3 sm:py-1.5 rounded-lg transition-colors" title="Déconnexion">
              <i class="fas fa-sign-out-alt"></i>
              <span class="hidden lg:inline ml-1.5 text-sm">Quitter</span>
            </a>
          <% } %>
          <button type="button" id="menu-mobile" class="md:hidden text-white p-2 focus:outline-none" aria-label="Menu">
            <i class="fas fa-bars text-xl"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Menu mobile déroulant -->
    <div id="menu-mobile-items" class="hidden md:hidden bg-primary border-t border-blue-700 px-4 py-2 space-y-1">
      <% if (user && user.type === 'admin') { %>
        <a href="/admin/dashboard" class="mobile-nav-link">Tableau de bord</a>
        <a href="/admin/utilisateurs" class="mobile-nav-link">Utilisateurs</a>
        <a href="/admin/demandes" class="mobile-nav-link">Demandes</a>
        <a href="/admin/classes" class="mobile-nav-link">Classes</a>
        <a href="/admin/matieres" class="mobile-nav-link">Matières</a>
        <a href="/admin/emploiDuTemps" class="mobile-nav-link">Emploi du temps</a>
      <% } else if (user && user.type === 'professeur') { %>
        <a href="/professeur/dashboard" class="mobile-nav-link">Tableau de bord</a>
        <a href="/professeur/notes" class="mobile-nav-link">Notes</a>
        <a href="/professeur/presences" class="mobile-nav-link">Présences</a>
        <a href="/professeur/devoirs" class="mobile-nav-link">Devoirs</a>
        <a href="/professeur/messages" class="mobile-nav-link">Messages</a>
      <% } else if (user && user.type === 'eleve') { %>
        <a href="/eleve/dashboard" class="mobile-nav-link">Mon espace</a>
        <a href="/eleve/notes" class="mobile-nav-link">Mes notes</a>
        <a href="/eleve/devoirs" class="mobile-nav-link">Devoirs</a>
        <a href="/eleve/presences" class="mobile-nav-link">Présences</a>
        <a href="/eleve/documents" class="mobile-nav-link">Documents</a>
      <% } else if (user && user.type === 'parent') { %>
        <a href="/parent/dashboard" class="mobile-nav-link">Tableau de bord</a>
        <a href="/parent/absences" class="mobile-nav-link">Absences</a>
        <a href="/parent/messages" class="mobile-nav-link">Messages</a>
      <% } %>
    </div>
  </nav>

  <!-- ===== MESSAGES FLASH ===== -->
  <% if (flash && flash.success && flash.success.length > 0) { %>
    <div class="flash-success mx-4 mt-4 p-4 bg-blue-50 border-l-4 border-secondary text-primary rounded-lg flex items-center justify-between" role="alert">
      <div class="flex items-center"><i class="fas fa-check-circle mr-2"></i><%= flash.success[0] %></div>
      <button onclick="this.parentElement.remove()" class="text-primary hover:text-secondary"><i class="fas fa-times"></i></button>
    </div>
  <% } %>
  <% if (flash && flash.error && flash.error.length > 0) { %>
    <div class="flash-error mx-4 mt-4 p-4 bg-red-100 border-l-4 border-red-500 text-red-800 rounded-lg flex items-center justify-between" role="alert">
      <div class="flex items-center"><i class="fas fa-exclamation-circle mr-2"></i><%= flash.error[0] %></div>
      <button onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800"><i class="fas fa-times"></i></button>
    </div>
  <% } %>
  <% if (flash && flash.warning && flash.warning.length > 0) { %>
    <div class="mx-4 mt-4 p-4 bg-amber-50 border-l-4 border-amber-500 text-amber-900 rounded-lg flex items-center justify-between" role="alert">
      <div class="flex items-center"><i class="fas fa-exclamation-triangle mr-2"></i><%= flash.warning[0] %></div>
      <button onclick="this.parentElement.remove()" class="text-amber-700 hover:text-amber-900"><i class="fas fa-times"></i></button>
    </div>
  <% } %>

  <!-- ===== CONTENU PRINCIPAL ===== -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <%- body %>
  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="bg-primary text-white text-center py-4 mt-8">
    <p class="text-sm opacity-75">
      &copy; <%= new Date().getFullYear() %> SmartSchool — Système Digital de Gestion Scolaire — Togo
      <span class="mx-2">|</span>
      <i class="fas fa-shield-alt mr-1"></i>Données sécurisées
    </p>
  </footer>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Script principal SmartSchool -->
  <script src="/js/main.js"></script>
</body>
</html>
