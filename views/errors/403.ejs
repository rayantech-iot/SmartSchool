<!-- views/errors/403.ejs -->
<div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
  <div class="w-32 h-32 bg-blue-100 rounded-full flex items-center justify-center text-primary mb-6">
    <i class="fas fa-user-shield text-5xl"></i>
  </div>
  <h1 class="text-4xl font-alkalami text-primary mb-2">403 — Accès interdit</h1>
  <p class="text-lg text-textDark max-w-md mb-8">
    <%= typeof message !== 'undefined' && message ? message : "Vous n'avez pas les autorisations nécessaires pour accéder à cette page." %>
  </p>
  <a href="/" class="btn-primary px-6 py-3 inline-flex items-center">
    <i class="fas fa-arrow-left mr-2"></i> Retour à l'accueil
  </a>
</div>
