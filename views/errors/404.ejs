<!-- views/errors/404.ejs -->
<div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
  <div class="w-32 h-32 bg-red-100 rounded-full flex items-center justify-center text-red-500 mb-6 animate-pulse">
    <i class="fas fa-exclamation-triangle text-5xl"></i>
  </div>
  <h1 class="text-4xl font-alkalami text-primary mb-2">404 — Page introuvable</h1>
  <p class="text-lg text-textDark max-w-md mb-8">
    <%= typeof message !== 'undefined' ? message : 'Désolé, la page que vous recherchez semble inexistante ou a été déplacée.' %>
  </p>
  <div>
    <a href="/" class="btn-primary px-6 py-3 inline-flex items-center space-x-2">
      <i class="fas fa-home"></i>
      <span>Retour à l'accueil</span>
    </a>
  </div>
</div>
