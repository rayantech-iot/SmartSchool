<!-- views/errors/500.ejs — Erreur serveur interne -->
<div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
  <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center mb-6">
    <i class="fas fa-server text-red-500 text-4xl"></i>
  </div>
  <h1 class="text-4xl font-bold font-alkalami text-primary mb-2">500</h1>
  <p class="text-lg text-textDark mb-2">Erreur serveur interne</p>
  <% if (typeof message !== 'undefined' && message) { %>
    <p class="text-sm text-red-600 bg-red-50 px-4 py-2 rounded-lg mb-4 max-w-lg"><%= message %></p>
  <% } %>
  <p class="text-gray-500 mb-8 max-w-md">Une erreur inattendue s'est produite. Veuillez réessayer ou contacter l'administrateur.</p>
  <a href="/" class="btn-primary inline-flex items-center">
    <i class="fas fa-home mr-2"></i> Retour à l'accueil
  </a>
</div>
