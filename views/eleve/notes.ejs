<!-- views/eleve/notes.ejs — Consultation des notes par matière -->
<div class="space-y-8 animate-fadeIn">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Mes Notes</h1>
      <p class="text-sm text-gray-500 mt-1">Consultez vos notes et moyennes par matière (calculées automatiquement).</p>
    </div>
    <a href="/eleve/dashboard" class="mt-4 md:mt-0 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
      <i class="fas fa-arrow-left mr-1"></i> Mon espace
    </a>
  </div>

  <% if (noteParMatiere.length === 0) { %>
    <div class="card-widget text-center py-12">
      <i class="fas fa-star text-4xl text-gray-300 mb-3"></i>
      <p class="text-gray-500">Aucune note enregistrée pour le moment.</p>
    </div>
  <% } %>

  <% noteParMatiere.forEach(g => { %>
    <div class="card-widget space-y-4">
      <div class="flex items-center justify-between border-b border-gray-100 pb-3">
        <div>
          <h2 class="text-xl font-bold text-gray-800"><%= g.matiere.nom %></h2>
          <p class="text-xs text-gray-500">Coefficient : <%= g.matiere.coefficient %> | Code : <%= g.matiere.code || '—' %></p>
        </div>
        <div class="text-right">
          <span class="text-xs text-gray-400 uppercase tracking-wider block">Moyenne matière</span>
          <span class="text-2xl font-bold <%= parseFloat(g.moyenne) >= 10 ? 'text-secondary' : 'text-red-500' %>">
            <%= g.moyenne %>/20
          </span>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="table-smartschool">
          <thead>
            <tr><th>Note</th><th>Type</th><th>Période</th><th>Date</th><th>Appréciation</th></tr>
          </thead>
          <tbody>
            <% g.notes.forEach(n => { %>
              <tr>
                <td><span class="font-bold <%= parseFloat(n.valeur) >= 10 ? 'text-secondary' : 'text-red-500' %>"><%= n.valeur %>/20</span></td>
                <td class="text-gray-600"><%= n.type_evaluation || '—' %></td>
                <td class="text-gray-600 capitalize"><%= n.periode || '—' %></td>
                <td class="text-gray-500 text-xs"><%= new Date(n.date_evaluation).toLocaleDateString('fr-FR') %></td>
                <td class="text-gray-500 text-xs italic"><%= n.appreciation || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% }) %>
</div>
