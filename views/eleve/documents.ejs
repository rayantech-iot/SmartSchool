<!-- views/eleve/documents.ejs — Espace documents personnels -->
<div class="space-y-8 animate-fadeIn">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Mes Documents</h1>
      <p class="text-sm text-gray-500 mt-1">Déposez, consultez et téléchargez vos documents personnels (PDF, DOCX, JPG, PNG — max 5 Mo).</p>
    </div>
    <a href="/eleve/dashboard" class="mt-4 md:mt-0 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
      <i class="fas fa-arrow-left mr-1"></i> Mon espace
    </a>
  </div>

  <!-- Formulaire d'upload -->
  <div class="card-widget">
    <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
      <i class="fas fa-cloud-upload-alt text-secondary mr-2"></i> Déposer un document
    </h2>
    <form action="/eleve/documents/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
      <%- include('../partials/csrfField') %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Fichier *</label>
          <input type="file" name="fichier" required accept=".pdf,.docx,.jpg,.jpeg,.png"
            class="form-input file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-primary file:text-white file:text-sm" />
          <p class="text-xs text-gray-400 mt-1">Formats : PDF, DOCX, JPG, PNG — Taille max : 5 Mo</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
          <input type="text" name="description" placeholder="Ex : Certificat médical" class="form-input" />
        </div>
      </div>
      <button type="submit" class="btn-primary inline-flex items-center">
        <i class="fas fa-upload mr-2"></i> Déposer le document
      </button>
    </form>
  </div>

  <!-- Liste des documents -->
  <div class="card-widget overflow-hidden p-0">
    <div class="p-4 border-b border-gray-100 bg-gray-50">
      <h2 class="font-bold text-gray-800">Documents déposés (<%= documents.length %>)</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="table-smartschool">
        <thead>
          <tr><th>Nom</th><th>Description</th><th>Taille</th><th>Date</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% documents.forEach(d => { %>
            <tr>
              <td class="font-semibold flex items-center gap-2">
                <i class="fas fa-file text-primary"></i>
                <%= d.nom_original %>
              </td>
              <td class="text-gray-500 text-sm"><%= d.description || '—' %></td>
              <td class="text-gray-500 text-xs"><%= (d.taille / 1024).toFixed(1) %> Ko</td>
              <td class="text-gray-500 text-xs"><%= new Date(d.createdAt).toLocaleDateString('fr-FR') %></td>
              <td class="space-x-2">
                <a href="/eleve/documents/<%= d.id %>/download" class="text-secondary hover:text-primary text-sm font-semibold">
                  <i class="fas fa-download"></i> Télécharger
                </a>
                <form action="/eleve/documents/<%= d.id %>/delete" method="POST" class="inline"
                  onsubmit="return confirm('Supprimer ce document ?')">
                  <%- include('../partials/csrfField') %>
                  <button type="submit" class="text-red-500 hover:text-red-700 text-sm font-semibold">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (documents.length === 0) { %>
            <tr><td colspan="5" class="text-center text-gray-400 py-10">Aucun document déposé.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
