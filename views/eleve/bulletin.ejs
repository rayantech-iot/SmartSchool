<!-- views/eleve/bulletin.ejs — Liste et visualisation des bulletins -->
<div class="space-y-8 animate-fadeIn">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4 no-print">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Mes Bulletins</h1>
      <p class="text-sm text-gray-500 mt-1">Consultez et téléchargez vos bulletins scolaires officiels.</p>
    </div>
    <div class="mt-4 md:mt-0 space-x-2">
      <% if (typeof bulletin !== 'undefined' && bulletin) { %>
        <a href="/eleve/bulletin" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
          <i class="fas fa-arrow-left mr-1"></i> Retour à la liste
        </a>
        <button onclick="window.print()" class="px-4 py-2 bg-primary hover:bg-blue-800 text-white text-sm font-bold rounded-xl shadow-md transition-all inline-flex items-center">
          <i class="fas fa-print mr-1.5"></i> Imprimer / PDF
        </button>
      <% } else { %>
        <a href="/eleve/dashboard" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
          <i class="fas fa-arrow-left mr-1"></i> Mon espace
        </a>
      <% } %>
    </div>
  </div>

  <% if (typeof bulletin !== 'undefined' && bulletin) { %>
    <!-- Visualisation bulletin (même structure que professeur) -->
    <%- include('../partials/bulletinAffichage') %>
  <% } else { %>
    <!-- Liste des bulletins -->
    <div class="card-widget overflow-hidden p-0">
      <div class="overflow-x-auto">
        <table class="table-smartschool">
          <thead>
            <tr><th>Période</th><th>Année scolaire</th><th>Moyenne générale</th><th>Date génération</th><th>Action</th></tr>
          </thead>
          <tbody>
            <% if (typeof bulletins !== 'undefined') { bulletins.forEach(b => { %>
              <tr>
                <td class="font-semibold capitalize"><%= b.periode %></td>
                <td><%= b.annee_scolaire %></td>
                <td>
                  <span class="font-bold <%= b.moyenne_generale && parseFloat(b.moyenne_generale) >= 10 ? 'text-secondary' : 'text-red-500' %>">
                    <%= b.moyenne_generale || 'N/A' %>/20
                  </span>
                </td>
                <td class="text-gray-500 text-xs"><%= new Date(b.date_generation).toLocaleDateString('fr-FR') %></td>
                <td>
                  <a href="/eleve/bulletin/<%= b.id %>" class="btn-secondary text-xs inline-flex items-center">
                    <i class="fas fa-eye mr-1"></i> Consulter
                  </a>
                </td>
              </tr>
            <% }) } %>
            <% if (!bulletins || bulletins.length === 0) { %>
              <tr><td colspan="5" class="text-center text-gray-400 py-10">
                <i class="fas fa-file-alt text-3xl text-gray-300 mb-2 block"></i>
                Aucun bulletin généré pour le moment.
              </td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>
