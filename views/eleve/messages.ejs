<!-- views/eleve/messages.ejs — Boîte de réception élève -->
<div class="space-y-8 animate-fadeIn">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Mes Messages</h1>
      <p class="text-sm text-gray-500 mt-1">Messages reçus de vos professeurs.</p>
    </div>
    <a href="/eleve/dashboard" class="mt-4 md:mt-0 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
      <i class="fas fa-arrow-left mr-1"></i> Mon espace
    </a>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="p-5 border-b bg-gray-50/50 flex justify-between items-center">
      <h2 class="font-bold text-gray-800 text-sm uppercase tracking-wider">
        <i class="fas fa-inbox text-primary mr-2"></i>Boîte de réception
        <% if (typeof nonLus !== 'undefined' && nonLus > 0) { %>
          <span class="ml-2 px-2 py-0.5 bg-red-500 text-white text-[10px] rounded-full"><%= nonLus %> non lus</span>
        <% } %>
      </h2>
      <span class="text-xs text-gray-400"><%= messages.length %> message(s)</span>
    </div>

    <div class="divide-y divide-gray-100">
      <% messages.forEach(m => { %>
        <div onclick="readMessage('<%= m.id %>')"
          class="p-4 hover:bg-slate-50 cursor-pointer flex items-center justify-between gap-4 <%= !m.lu ? 'bg-blue-50/20 border-l-4 border-blue-500' : '' %>">
          <div>
            <p class="text-sm font-semibold text-gray-800">
              <%= m.expediteur ? m.expediteur.prenom + ' ' + m.expediteur.nom : 'Expéditeur inconnu' %>
            </p>
            <p class="text-sm text-gray-600 truncate max-w-md"><%= m.sujet %></p>
          </div>
          <span class="text-[10px] text-gray-400 flex-shrink-0"><%= new Date(m.createdAt).toLocaleDateString('fr-FR') %></span>
        </div>
      <% }) %>
      <% if (messages.length === 0) { %>
        <p class="p-12 text-center text-gray-400 italic">Aucun message reçu.</p>
      <% } %>
    </div>
  </div>
</div>

<div id="read-message-modal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl">
    <h3 class="font-bold text-gray-900 mb-1" id="read-msg-sujet">Sujet</h3>
    <p class="text-xs text-gray-400 mb-4" id="read-msg-expediteur"></p>
    <div class="bg-slate-50 p-4 rounded-xl text-sm text-gray-700 min-h-[100px] whitespace-pre-line" id="read-msg-contenu"></div>
    <button onclick="closeReadMessageModal()" class="mt-4 btn-primary">Fermer</button>
  </div>
</div>

<script>
  function getCsrfToken() {
    return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
  }
  async function readMessage(msgId) {
    const res = await fetch('/eleve/messages/' + msgId, {
      headers: { 'X-CSRF-Token': getCsrfToken() }
    });
    if (res.ok) {
      const msg = await res.json();
      document.getElementById('read-msg-sujet').innerText = msg.sujet;
      document.getElementById('read-msg-expediteur').innerText = 'De : ' + (msg.expediteur ? msg.expediteur.prenom + ' ' + msg.expediteur.nom : '');
      document.getElementById('read-msg-contenu').innerText = msg.contenu;
      document.getElementById('read-message-modal').classList.remove('hidden');
    }
  }
  function closeReadMessageModal() {
    document.getElementById('read-message-modal').classList.add('hidden');
    window.location.reload();
  }
</script>
