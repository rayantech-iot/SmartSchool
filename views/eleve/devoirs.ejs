<!-- views/eleve/devoirs.ejs — Devoirs publiés pour la classe -->
<div class="space-y-8 animate-fadeIn">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Mes Devoirs</h1>
      <p class="text-sm text-gray-500 mt-1">Devoirs publiés par vos professeurs pour votre classe.</p>
    </div>
    <a href="/eleve/dashboard" class="mt-4 md:mt-0 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
      <i class="fas fa-arrow-left mr-1"></i> Mon espace
    </a>
  </div>

  <div class="space-y-4">
    <% devoirs.forEach(d => { %>
      <% const estEnRetard = new Date(d.date_limite) < new Date(); %>
      <div class="card-widget border-l-4 <%= estEnRetard ? 'border-red-500' : 'border-secondary' %>">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 bg-blue-100 text-blue-800 text-[10px] font-bold rounded"><%= d.matiere ? d.matiere.nom : 'Matière' %></span>
              <% if (estEnRetard) { %>
                <span class="px-2 py-0.5 bg-red-100 text-red-700 text-[10px] font-bold rounded">En retard</span>
              <% } %>
            </div>
            <h3 class="text-lg font-bold text-gray-800"><%= d.titre %></h3>
            <p class="text-sm text-gray-600"><%= d.description || 'Pas de consigne supplémentaire.' %></p>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-xs text-gray-400 uppercase font-semibold">À rendre pour le</p>
            <p class="text-sm font-bold font-mono <%= estEnRetard ? 'text-red-600' : 'text-primary' %>">
              <%= new Date(d.date_limite).toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
          </div>
        </div>
      </div>
    <% }) %>

    <% if (devoirs.length === 0) { %>
      <div class="card-widget text-center py-12">
        <i class="fas fa-tasks text-4xl text-gray-300 mb-3"></i>
        <p class="text-gray-500">Aucun devoir publié pour votre classe.</p>
      </div>
    <% } %>
  </div>
</div>
