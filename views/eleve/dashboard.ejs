<!-- views/eleve/dashboard.ejs — Tableau de bord élève -->
<div class="space-y-8 animate-fadeIn">

  <div class="page-header flex flex-col md:flex-row md:items-center md:justify-between">
    <div>
      <span class="px-2.5 py-1 bg-white/20 rounded-lg text-xs font-bold uppercase tracking-wider">Espace Élève</span>
      <h1 class="text-3xl font-bold font-alkalami mt-2">Bonjour, <%= eleve.utilisateur ? eleve.utilisateur.prenom : user.prenom %> !</h1>
      <p class="mt-1 text-blue-100 text-sm">
        <% if (eleve.classe) { %>
          <%= eleve.classe.niveau %> — <%= eleve.classe.nom %>
          <% if (eleve.matricule) { %> | Matricule : <%= eleve.matricule %><% } %>
        <% } else { %>
          Classe non assignée
        <% } %>
      </p>
    </div>
    <% if (moyenneGenerale) { %>
      <div class="mt-4 md:mt-0 bg-white/10 backdrop-blur rounded-xl px-6 py-3 text-center">
        <p class="text-xs uppercase tracking-wider text-blue-200">Moyenne générale</p>
        <p class="text-3xl font-bold"><%= moyenneGenerale %><span class="text-sm font-normal">/20</span></p>
      </div>
    <% } %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="card-widget flex items-center space-x-4">
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
        <i class="fas fa-star text-2xl"></i>
      </div>
      <div>
        <p class="text-sm text-gray-400 uppercase tracking-wider">Notes récentes</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= notesRecentes.length %></h3>
      </div>
    </div>
    <div class="card-widget flex items-center space-x-4">
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-secondary flex items-center justify-center">
        <i class="fas fa-tasks text-2xl"></i>
      </div>
      <div>
        <p class="text-sm text-gray-400 uppercase tracking-wider">Devoirs à rendre</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= devoirsAVenir.length %></h3>
      </div>
    </div>
    <div class="card-widget flex items-center space-x-4">
      <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
        <i class="fas fa-calendar-times text-2xl"></i>
      </div>
      <div>
        <p class="text-sm text-gray-400 uppercase tracking-wider">Absences non justifiées</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= absencesNonJustifiees %></h3>
      </div>
    </div>
    <div class="card-widget flex items-center space-x-4">
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-primary flex items-center justify-center">
        <i class="fas fa-envelope text-2xl"></i>
      </div>
      <div>
        <p class="text-sm text-gray-400 uppercase tracking-wider">Messages non lus</p>
        <h3 class="text-2xl font-bold text-gray-800"><%= messagesNonLus %></h3>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Graphique moyennes par matière -->
    <div class="card-widget">
      <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
        <i class="fas fa-chart-bar text-primary mr-2"></i> Moyennes par matière
      </h2>
      <% if (chartLabels && chartLabels.length > 0) { %>
        <canvas id="chartMoyennes" height="200"></canvas>
        <script>
          document.addEventListener('DOMContentLoaded', function() {
            new Chart(document.getElementById('chartMoyennes'), {
              type: 'bar',
              data: {
                labels: <%- JSON.stringify(chartLabels) %>,
                datasets: [{
                  label: 'Moyenne /20',
                  data: <%- JSON.stringify(chartData) %>,
                  backgroundColor: '#3B82F6',
                  borderRadius: 6
                }]
              },
              options: {
                responsive: true,
                scales: { y: { min: 0, max: 20 } },
                plugins: { legend: { display: false } }
              }
            });
          });
        </script>
      <% } else { %>
        <p class="text-sm text-gray-400 italic text-center py-8">Aucune note enregistrée pour le moment.</p>
      <% } %>
    </div>

    <!-- Devoirs du jour -->
    <div class="card-widget">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold text-gray-800 flex items-center">
          <i class="fas fa-tasks text-secondary mr-2"></i> Devoirs à venir
        </h2>
        <a href="/eleve/devoirs" class="text-xs text-secondary font-semibold">Voir tout →</a>
      </div>
      <div class="space-y-3">
        <% devoirsAVenir.forEach(d => { %>
          <div class="p-3 bg-gray-50 rounded-xl border border-gray-100">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[10px] font-bold text-primary bg-blue-100 px-2 py-0.5 rounded"><%= d.matiere ? d.matiere.nom : 'Matière' %></span>
                <h4 class="font-bold text-sm text-gray-800 mt-1"><%= d.titre %></h4>
              </div>
              <span class="text-xs font-mono text-red-600 font-bold"><%= new Date(d.date_limite).toLocaleDateString('fr-FR') %></span>
            </div>
          </div>
        <% }) %>
        <% if (devoirsAVenir.length === 0) { %>
          <p class="text-sm text-gray-400 italic text-center py-6">Aucun devoir à rendre prochainement.</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Notes récentes -->
  <div class="card-widget">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold text-gray-800 flex items-center">
        <i class="fas fa-star text-secondary mr-2"></i> Dernières notes
      </h2>
      <a href="/eleve/notes" class="text-xs text-secondary font-semibold">Toutes mes notes →</a>
    </div>
    <div class="overflow-x-auto">
      <table class="table-smartschool">
        <thead>
          <tr><th>Matière</th><th>Note</th><th>Type</th><th>Date</th></tr>
        </thead>
        <tbody>
          <% notesRecentes.forEach(n => { %>
            <tr>
              <td class="font-semibold"><%= n.matiere ? n.matiere.nom : '—' %></td>
              <td><span class="font-bold <%= parseFloat(n.valeur) >= 10 ? 'text-secondary' : 'text-red-500' %>"><%= n.valeur %>/20</span></td>
              <td class="text-gray-500 text-xs"><%= n.type_evaluation || '—' %></td>
              <td class="text-gray-500 text-xs"><%= new Date(n.date_evaluation).toLocaleDateString('fr-FR') %></td>
            </tr>
          <% }) %>
          <% if (notesRecentes.length === 0) { %>
            <tr><td colspan="4" class="text-center text-gray-400 py-6">Aucune note pour le moment.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Raccourcis -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <a href="/eleve/bulletin" class="card-widget text-center hover:border-primary transition-colors group">
      <i class="fas fa-file-alt text-2xl text-primary group-hover:scale-110 transition-transform"></i>
      <p class="text-sm font-semibold mt-2 text-gray-700">Mes bulletins</p>
    </a>
    <a href="/eleve/presences" class="card-widget text-center hover:border-primary transition-colors group">
      <i class="fas fa-calendar-check text-2xl text-secondary group-hover:scale-110 transition-transform"></i>
      <p class="text-sm font-semibold mt-2 text-gray-700">Présences</p>
    </a>
    <a href="/eleve/documents" class="card-widget text-center hover:border-primary transition-colors group">
      <i class="fas fa-folder text-2xl text-secondary group-hover:scale-110 transition-transform"></i>
      <p class="text-sm font-semibold mt-2 text-gray-700">Documents</p>
    </a>
    <a href="/eleve/emploiDuTemps" class="card-widget text-center hover:border-primary transition-colors group">
      <i class="fas fa-calendar text-2xl text-primary group-hover:scale-110 transition-transform"></i>
      <p class="text-sm font-semibold mt-2 text-gray-700">Emploi du temps</p>
    </a>
  </div>
</div>
