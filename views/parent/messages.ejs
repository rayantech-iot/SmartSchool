<!-- views/parent/messages.ejs — Messagerie parent (contact professeurs) -->
<div class="space-y-8 animate-fadeIn">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4">
    <div>
      <h1 class="text-3xl font-bold font-alkalami text-gray-800">Messagerie</h1>
      <p class="text-sm text-gray-500 mt-1">Contactez les professeurs de votre enfant.</p>
    </div>
    <a href="/parent/dashboard" class="mt-4 md:mt-0 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition-all inline-flex items-center">
      <i class="fas fa-arrow-left mr-1"></i> Tableau de bord
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div class="space-y-4">
      <a href="/parent/messages/compose"
        class="w-full py-3 bg-secondary hover:bg-primary text-white font-bold rounded-xl shadow-md transition-all flex items-center justify-center space-x-2">
        <i class="fas fa-edit"></i><span>Contacter un professeur</span>
      </a>
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
        <a href="/parent/messages"
          class="flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-semibold <%= section === 'inbox' ? 'bg-blue-50 text-primary' : 'text-gray-600 hover:bg-gray-50' %>">
          <span><i class="fas fa-inbox mr-2"></i>Boîte de réception</span>
          <% if (typeof nonLus !== 'undefined' && nonLus > 0) { %>
            <span class="px-2 py-0.5 bg-red-500 text-white text-[10px] font-bold rounded-full"><%= nonLus %></span>
          <% } %>
        </a>
      </div>
    </div>

    <div class="lg:col-span-3">
      <% if (section === 'inbox') { %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="p-5 border-b bg-gray-50/50">
            <h2 class="font-bold text-gray-800 text-sm uppercase tracking-wider"><i class="fas fa-inbox text-primary mr-2"></i>Messages reçus</h2>
          </div>
          <div class="divide-y divide-gray-100">
            <% messages.forEach(m => { %>
              <div onclick="readMessage('<%= m.id %>')"
                class="p-4 hover:bg-slate-50 cursor-pointer flex items-center justify-between gap-4 <%= !m.lu ? 'bg-blue-50/20 border-l-4 border-blue-500 font-semibold' : '' %>">
                <div>
                  <p class="text-sm text-gray-800"><%= m.expediteur ? m.expediteur.prenom + ' ' + m.expediteur.nom : 'Inconnu' %></p>
                  <p class="text-xs text-gray-500 truncate max-w-md"><%= m.sujet %></p>
                </div>
                <span class="text-[10px] text-gray-400"><%= new Date(m.createdAt).toLocaleDateString('fr-FR') %></span>
              </div>
            <% }) %>
            <% if (messages.length === 0) { %>
              <p class="p-12 text-center text-gray-400 italic">Aucun message reçu.</p>
            <% } %>
          </div>
        </div>
      <% } else if (section === 'compose') { %>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <h2 class="text-xl font-bold text-gray-800 mb-6"><i class="fas fa-paper-plane text-primary mr-2"></i>Nouveau message</h2>
          <form action="/parent/messages/send" method="POST" class="space-y-4">
      <%- include('../partials/csrfField') %>
            <input type="hidden" name="type_envoi" value="individuel" />
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Professeur destinataire</label>
              <select name="destinataire_id" required class="form-input">
                <option value="">-- Choisir un professeur --</option>
                <% destinataires.forEach(d => { %>
                  <option value="<%= d.id %>"><%= d.prenom %> <%= d.nom %> — <%= d.email %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Sujet</label>
              <input type="text" name="sujet" required class="form-input" placeholder="Objet du message" />
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Message</label>
              <textarea name="contenu" rows="6" required class="form-input" placeholder="Votre message..."></textarea>
            </div>
            <button type="submit" class="w-full py-3 bg-primary hover:bg-secondary text-white font-bold rounded-xl transition-all">
              Envoyer le message
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div id="read-message-modal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl">
    <h3 class="font-bold text-gray-900 mb-1" id="read-msg-sujet">Sujet</h3>
    <p class="text-xs text-gray-400 mb-4" id="read-msg-expediteur"></p>
    <div class="bg-slate-50 p-4 rounded-xl text-sm text-gray-700 min-h-[100px] whitespace-pre-line" id="read-msg-contenu"></div>
    <button onclick="closeReadMessageModal()" class="mt-4 btn-primary">Fermer</button>
  </div>
</div>

<script>
  async function readMessage(msgId) {
    const res = await fetch('/parent/messages/' + msgId);
    if (res.ok) {
      const msg = await res.json();
      document.getElementById('read-msg-sujet').innerText = msg.sujet;
      document.getElementById('read-msg-expediteur').innerText = 'De : ' + (msg.expediteur ? msg.expediteur.prenom + ' ' + msg.expediteur.nom : '');
      document.getElementById('read-msg-contenu').innerText = msg.contenu;
      document.getElementById('read-message-modal').classList.remove('hidden');
    }
  }
  function closeReadMessageModal() {
    document.getElementById('read-message-modal').classList.add('hidden');
    window.location.reload();
  }
</script>
