NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartschool

SESSION_SECRET=changez_cette_cle_secrete_tres_longue_et_aleatoire

UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=public/uploads

# Email (SMTP) — si non configuré, les emails s'affichent dans la console serveur
# Test : npm run mail:test
#        npm run mail:test votre@email.com
#
# --- Gmail (recommandé pour les tests) ---
# 1. Compte Google → Sécurité → Validation en 2 étapes (activée)
# 2. Mots de passe des applications → créer → copier le code 16 caractères
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM="SmartSchool <votre.email@gmail.com>"
#
# --- Outlook / Hotmail ---
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartSchool <noreply@smartschool.tg>"

APP_NAME=SmartSchool
APP_URL=http://localhost:3000

# Logs SQL Sequelize dans le terminal (true = verbeux, laisser false en dev normal)
DB_LOGGING=false
